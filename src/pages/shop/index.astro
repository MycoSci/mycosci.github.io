---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProducts, getProductCategories } from '../../lib/wordpress';

let products = [];
let categories = [];
let error = null;

try {
  products = await getProducts(20);
  categories = await getProductCategories();
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load products';
}
---

<BaseLayout title="Shop | MycoSci">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <!-- Header -->
    <div class="mb-12">
      <span class="label text-bio-500">LAB SUPPLIES</span>
      <h1 class="text-3xl sm:text-4xl font-bold text-lab-100 mt-2">Shop</h1>
      <p class="text-lab-400 mt-2">Agar, cultures, and equipment for serious cultivation.</p>
    </div>

    {error && (
      <div class="card p-4 border-spore-500/50 bg-spore-500/10 mb-8">
        <p class="text-spore-400 text-sm">{error}</p>
      </div>
    )}

    <!-- Categories -->
    {categories.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        <a href="/shop" class="badge badge-bio">All Products</a>
        {categories.map((cat) => (
          <a href={`/shop/category/${cat.slug}`} class="badge bg-lab-800 text-lab-300 border-lab-700 hover:border-bio-600 transition-colors">
            {cat.name} ({cat.count})
          </a>
        ))}
      </div>
    )}

    <!-- Products Grid -->
    {products.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {products.map((product) => (
          <div class="card card-hover overflow-hidden group">
            <a href={`/shop/${product.slug}`} class="block">
              <div class="aspect-square bg-lab-800 flex items-center justify-center relative">
                {product.image?.sourceUrl ? (
                  <img src={product.image.sourceUrl} alt={product.name} class="w-full h-full object-cover" />
                ) : (
                  <span class="text-5xl opacity-20">🧫</span>
                )}
                {product.onSale && (
                  <span class="absolute top-3 right-3 badge badge-spore">Sale</span>
                )}
              </div>
            </a>
            <div class="p-4">
              <div class="text-2xs font-mono text-lab-500 uppercase tracking-wider mb-1">
                {product.productCategories?.nodes?.[0]?.name || 'Product'}
              </div>
              <a href={`/shop/${product.slug}`}>
                <h3 class="font-medium text-lab-100 group-hover:text-bio-400 transition-colors mb-2">
                  {product.name}
                </h3>
              </a>
              <p class="text-xs text-lab-500 line-clamp-2 mb-3" set:html={product.shortDescription} />
              <div class="flex items-center justify-between">
                <div class="flex items-baseline gap-2">
                  <span class="text-lg font-bold text-mycel-400 font-mono">{product.price || 'TBD'}</span>
                  {product.salePrice && product.regularPrice !== product.salePrice && (
                    <span class="text-sm text-lab-600 line-through font-mono">{product.regularPrice}</span>
                  )}
                </div>
                <button
                  class="add-to-cart-btn btn btn-primary text-xs py-1.5"
                  data-id={product.databaseId}
                  data-name={product.name}
                  data-price={product.price || '0'}
                  data-image={product.image?.sourceUrl || ''}
                >
                  Add to Cart
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : !error && (
      <div class="card p-12 text-center">
        <span class="text-5xl opacity-30 block mb-4">🧫</span>
        <p class="text-lab-400">No products available yet.</p>
        <a href="http://localhost:8888/wp-admin/edit.php?post_type=product" target="_blank" class="text-bio-400 text-sm mt-2 inline-block hover:underline">
          Add products in WordPress →
        </a>
      </div>
    )}
  </div>

  <!-- Toast notification -->
  <div id="cart-toast" class="fixed bottom-4 right-4 transform translate-y-full opacity-0 transition-all duration-300 z-50">
    <div class="card p-4 bg-bio-950 border-bio-600 flex items-center gap-3">
      <svg class="w-5 h-5 text-bio-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      <span class="text-sm text-lab-200">Added to cart!</span>
      <a href="/cart" class="text-xs text-bio-400 hover:underline ml-2">View Cart</a>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.add-to-cart-btn');
    const toast = document.getElementById('cart-toast');

    buttons.forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();

        const btn = e.currentTarget as HTMLButtonElement;
        const id = parseInt(btn.dataset.id || '0');
        const name = btn.dataset.name || '';
        const price = btn.dataset.price || '0';
        const image = btn.dataset.image || '';

        // Get current cart
        let cart = { items: [], total: 0 };
        try {
          cart = JSON.parse(localStorage.getItem('mycosci_cart') || '{"items":[],"total":0}');
        } catch (e) {}

        // Add item
        const existingIndex = cart.items.findIndex((i: any) => i.id === id);
        if (existingIndex >= 0) {
          cart.items[existingIndex].quantity += 1;
        } else {
          cart.items.push({ id, name, price, image, quantity: 1 });
        }

        // Calculate total
        cart.total = cart.items.reduce((sum: number, item: any) => {
          const p = parseFloat(item.price.replace(/[^0-9.]/g, '')) || 0;
          return sum + (p * item.quantity);
        }, 0);

        // Save cart
        localStorage.setItem('mycosci_cart', JSON.stringify(cart));
        window.dispatchEvent(new CustomEvent('cart-updated', { detail: cart }));

        // Button feedback
        const originalText = btn.textContent;
        btn.textContent = 'Added!';
        btn.disabled = true;
        btn.classList.remove('btn-primary');
        btn.classList.add('btn-secondary');

        setTimeout(() => {
          btn.textContent = originalText;
          btn.disabled = false;
          btn.classList.add('btn-primary');
          btn.classList.remove('btn-secondary');
        }, 1500);

        // Show toast
        if (toast) {
          toast.classList.remove('translate-y-full', 'opacity-0');
          setTimeout(() => {
            toast.classList.add('translate-y-full', 'opacity-0');
          }, 3000);
        }
      });
    });
  });
</script>
