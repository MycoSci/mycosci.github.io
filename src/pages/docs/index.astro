---
import starlightConfig from '../../../starlight.config.mjs';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { buildSidebar, titleFromEntry } from '../../utils/docsNav';
import { getCollection, getEntry } from 'astro:content';

const docs = await getCollection('docs');
const entry = await getEntry('docs', 'index');

if (!entry) {
  throw new Error('Docs index entry is missing.');
}

const { Content, headings } = await entry.render();
const sidebar = buildSidebar(docs, starlightConfig.sidebar, entry.slug);
const pageTitle = entry.data.title ?? titleFromEntry(entry);
const description = entry.data.description;

---
<DocsLayout title={pageTitle} description={description} sections={sidebar} headings={headings}>
  <Content />
</DocsLayout>
