---
export async function getStaticPaths() {
  const pages = import.meta.glob('../../content/docs/{lab,cultivation}/**/*.{md,mdx}');
  return Object.keys(pages).map(path => {
    const relative = path
      .replace('../../content/docs/', '')
      .replace(/\.(md|mdx)$/, '')
      .replace(/\/index$/, '');
    return { params: { slug: relative } };
  });
}

const slugParam = Astro.params.slug;
const slugPath = Array.isArray(slugParam) ? slugParam.join('/') : slugParam ?? '';
const baseHref = import.meta.env.STARLIGHT_ENABLED ? '/docs/' : '/mycopedia/';
const redirectTarget = slugPath ? `${baseHref}${slugPath}` : `${baseHref}lab/intro`;
return Astro.redirect(redirectTarget.endsWith('/') ? redirectTarget : `${redirectTarget}/`);
---
