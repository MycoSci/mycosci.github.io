---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('docs'))
    .filter((d) => d.id.startsWith('blog/') && !d.id.startsWith('blog/authors') && d.id !== 'blog/index');
  return posts.map((post) => ({ params: { slug: post.id.replace(/^blog\//, '') }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date | undefined) =>
  d ? new Date(d).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) : '';
---

<BaseLayout title={`${post.data.title} | MycoSci`} description={post.data.description}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
    <nav class="text-2xs font-mono uppercase tracking-wider text-lab-500 mb-8">
      <a href="/blog" class="hover:text-bio-400 transition-colors">← Field Notes</a>
    </nav>

    <header class="border-b border-lab-800 pb-8 mb-8">
      <div class="flex items-center gap-3 text-2xs font-mono uppercase tracking-wider text-lab-500 mb-3">
        <span>{fmt(post.data.pubDate)}</span>
        {post.data.author && <><span class="text-lab-700">/</span><span>{post.data.author}</span></>}
      </div>
      <h1 class="text-3xl sm:text-4xl font-semibold text-lab-100 tracking-tight">{post.data.title}</h1>
      {post.data.description && <p class="text-lab-400 mt-3 text-lg">{post.data.description}</p>}
    </header>

    <div class="prose prose-invert max-w-none
      prose-headings:text-lab-100 prose-headings:font-semibold
      prose-p:text-lab-300 prose-p:leading-relaxed
      prose-a:text-bio-400 prose-a:no-underline hover:prose-a:underline
      prose-strong:text-lab-100 prose-li:text-lab-300
      prose-blockquote:border-bio-600 prose-blockquote:text-lab-400
      prose-code:text-bio-400 prose-img:border prose-img:border-lab-800">
      <Content />
    </div>
  </article>
</BaseLayout>
