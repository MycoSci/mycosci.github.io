---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('docs'))
  .filter((d) => d.id.startsWith('blog/') && !d.id.startsWith('blog/authors') && d.id !== 'blog/index')
  .sort((a, b) => +(b.data.pubDate ?? 0) - +(a.data.pubDate ?? 0));

const slugOf = (id: string) => id.replace(/^blog\//, '');
const fmt = (d: Date | undefined) =>
  d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase() : '';
---

<BaseLayout title="Field Notes | MycoSci">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
    <div class="border-b border-lab-800 pb-8 mb-8">
      <span class="label text-bio-500">// Field Notes</span>
      <h1 class="text-3xl sm:text-4xl font-semibold text-lab-100 mt-2 tracking-tight">Field Notes</h1>
      <p class="text-lab-400 mt-2 max-w-2xl">Essays and notes on mycology, cultivation, and the science of fungi.</p>
    </div>

    {posts.length === 0 ? (
      <p class="text-lab-500 font-mono text-sm">No notes published yet.</p>
    ) : (
      <div class="border-t border-lab-800">
        {posts.map((post) => (
          <a href={`/blog/${slugOf(post.id)}`} class="group block border-b border-lab-800 py-6 hover:bg-lab-900 -mx-4 px-4 transition-colors">
            <div class="flex items-center gap-3 text-2xs font-mono uppercase tracking-wider text-lab-500 mb-2">
              <span>{fmt(post.data.pubDate)}</span>
              {post.data.author && <><span class="text-lab-700">/</span><span>{post.data.author}</span></>}
            </div>
            <h2 class="text-xl font-semibold text-lab-100 group-hover:text-bio-400 transition-colors">{post.data.title}</h2>
            {post.data.description && <p class="text-sm text-lab-400 mt-1.5 leading-relaxed">{post.data.description}</p>}
            {post.data.tags?.length && (
              <div class="flex flex-wrap gap-2 mt-3">
                {post.data.tags.map((t) => <span class="badge border-lab-700 text-lab-500">{t}</span>)}
              </div>
            )}
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
