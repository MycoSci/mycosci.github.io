---
import BaseLayout from '../../layouts/BaseLayout.astro';

const design = [
  {
    title: 'On-device',
    body: 'A compact MobileNetV3 classifier compiled to run in the browser via WebAssembly. The model downloads once, then identification happens locally on your phone or laptop.',
  },
  {
    title: 'Offline-capable',
    body: 'After the first load the model is cached. No connection, no server round-trip, no upload — the image is processed entirely on your device.',
  },
  {
    title: 'Privacy-preserving',
    body: 'Photos never leave the device. There is no account, no cloud inference and no telemetry. The site is static; there is nothing to collect.',
  },
  {
    title: 'Source-linked',
    body: 'Every candidate links straight into the catalog — taxonomy, look-alikes and edibility notes — so a guess is always a starting point for verification, never an answer.',
  },
];

const open = [
  ['Training data', 'Research-grade, openly-licensed observations (iNaturalist, GBIF). No proprietary set; the corpus and splits will be documented.'],
  ['Model size', 'Targeting a quantized model small enough to ship over GitHub Pages and load on a phone — single-digit to low-tens of MB.'],
  ['Coverage', 'Beginning with a few hundred commonly-photographed species, expanding as the curated catalog tier grows.'],
  ['Honesty', 'Confidence will be shown plainly, and low-confidence results stated as such. No invented accuracy figure ships until there is a measured one.'],
];
---

<BaseLayout title="AI Identification | MycoSci">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
    <!-- Header -->
    <div class="border-b border-lab-800 pb-8 mb-8">
      <div class="flex items-center gap-3">
        <span class="label text-bio-500">// Identification</span>
        <span class="badge badge-spore">Planned</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-semibold text-lab-100 mt-2 tracking-tight">On-device AI identification</h1>
      <p class="text-lab-400 mt-3 max-w-2xl leading-relaxed">
        An offline, privacy-preserving mushroom classifier that runs entirely in your browser — no upload,
        no account, no server. It is a planned pillar of MycoSci. It is not built yet, and this page is
        honest about that.
      </p>
      <div class="flex flex-wrap gap-x-6 gap-y-2 mt-5 text-2xs font-mono uppercase tracking-wider text-lab-500">
        <span>Approach · MobileNetV3 / WASM</span>
        <span>Runtime · In-browser</span>
        <span>Data · Stays on device</span>
        <span>Status · Not live</span>
      </div>
    </div>

    <!-- Safety caution (load-bearing) -->
    <div class="border-l-2 border-spore-600 bg-spore-600/5 px-4 py-4 mb-12">
      <p class="font-mono text-2xs uppercase tracking-wider text-spore-400">Safety · Read this</p>
      <p class="text-sm text-lab-300 mt-2 leading-relaxed">
        No phone app — ours or anyone else's — is a safe basis for deciding whether a fungus is edible.
        Deadly and edible species can look nearly identical, and a classifier returns a guess, not a fact.
        Never eat a wild fungus identified by software. Confirm with multiple reliable references and an
        experienced local identifier first.
      </p>
    </div>

    <!-- What it will be -->
    <h2 class="label mb-4">// What it will be</h2>
    <div class="grid sm:grid-cols-2 border-t border-l border-lab-800 mb-12">
      {design.map((d) => (
        <div class="border-b border-r border-lab-800 p-6">
          <h3 class="text-base font-semibold text-lab-100">{d.title}</h3>
          <p class="text-sm text-lab-400 mt-2 leading-relaxed">{d.body}</p>
        </div>
      ))}
    </div>

    <!-- Why it isn't live -->
    <h2 class="label mb-4">// Why it isn't live</h2>
    <div class="card p-6 mb-12">
      <p class="text-sm text-lab-400 leading-relaxed">
        There is no trained model yet. MycoSci is a static, volunteer-built project, and a useful identifier
        needs a carefully assembled training set, an honestly measured evaluation, and a model small enough
        to ship for free over GitHub Pages. We would rather ship nothing than ship a fake accuracy number or
        a model that misleads people about a safety-relevant decision. When there is a real model, it lands here.
      </p>
    </div>

    <!-- Design notes -->
    <h2 class="label mb-4">// Design notes</h2>
    <div class="border-t border-lab-800 mb-12">
      {open.map(([k, v]) => (
        <div class="grid sm:grid-cols-[180px_1fr] gap-x-6 gap-y-1 border-b border-lab-800 py-4">
          <span class="font-mono text-2xs uppercase tracking-wider text-lab-500">{k}</span>
          <span class="text-sm text-lab-400 leading-relaxed">{v}</span>
        </div>
      ))}
    </div>

    <!-- Follow / contribute -->
    <div class="border border-lab-800 p-8">
      <span class="label text-bio-500">// Get involved</span>
      <h2 class="text-2xl font-semibold text-lab-100 mt-3 max-w-2xl">Help build it.</h2>
      <p class="text-lab-400 mt-4 max-w-2xl leading-relaxed">
        Curating the catalog tier and sourcing openly-licensed, labelled imagery is the work that unblocks
        this. The model follows the data. Everything is in the open repository.
      </p>
      <div class="flex flex-wrap gap-3 mt-8">
        <a href="https://github.com/MycoSci" class="btn btn-primary">Contribute on GitHub</a>
        <a href="/database" class="btn btn-ghost">Browse Catalog →</a>
      </div>
    </div>
  </div>
</BaseLayout>
