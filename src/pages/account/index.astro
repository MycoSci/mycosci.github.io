---
import BaseLayout from '../../layouts/BaseLayout.astro';

const points = [
  {
    title: 'No login',
    body: 'There is nothing to sign into. No email, no password, no social auth. The whole site is static files served from GitHub Pages.',
  },
  {
    title: 'No paywall',
    body: 'Every species record, tek, dataset and the full JSON API are free and always will be. There is no premium tier and no subscription.',
  },
  {
    title: 'No tracking',
    body: 'No accounts means nothing to profile. We are not collecting your identity, your searches or your photos.',
  },
  {
    title: 'Yours to fork',
    body: 'The catalog is open data under CC-BY and the code is open source. Take it, mirror it, build on it.',
  },
];
---

<BaseLayout title="Accounts | MycoSci">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
    <!-- Header -->
    <div class="border-b border-lab-800 pb-8 mb-8">
      <span class="label text-bio-500">// Accounts</span>
      <h1 class="text-3xl sm:text-4xl font-semibold text-lab-100 mt-2 tracking-tight">There are no accounts.</h1>
      <p class="text-lab-400 mt-3 max-w-2xl leading-relaxed">
        MycoSci is open and free. There is no sign-in, no profile and no paywall — by design. Nothing here is
        gated, so there is nothing to log into. Contribution happens in the open, on GitHub.
      </p>
      <div class="flex flex-wrap gap-x-6 gap-y-2 mt-5 text-2xs font-mono uppercase tracking-wider text-lab-500">
        <span>Auth · None</span>
        <span>Cost · Free</span>
        <span>Data · Open · CC-BY</span>
        <span>Hosting · Static · GitHub Pages</span>
      </div>
    </div>

    <!-- Points -->
    <div class="grid sm:grid-cols-2 border-t border-l border-lab-800 mb-12">
      {points.map((p) => (
        <div class="border-b border-r border-lab-800 p-6">
          <h2 class="text-base font-semibold text-lab-100">{p.title}</h2>
          <p class="text-sm text-lab-400 mt-2 leading-relaxed">{p.body}</p>
        </div>
      ))}
    </div>

    <!-- Contribute -->
    <div class="border border-lab-800 p-8">
      <span class="label text-bio-500">// Contribute</span>
      <h2 class="text-2xl font-semibold text-lab-100 mt-3 max-w-2xl">
        Want to contribute? That happens on GitHub.
      </h2>
      <p class="text-lab-400 mt-4 max-w-2xl leading-relaxed">
        Fixing a record, adding a source, writing a tek or improving the data — open a pull request or an
        issue. That is the whole account system: your commit history, in public.
      </p>
      <div class="flex flex-wrap gap-3 mt-8">
        <a href="https://github.com/MycoSci" class="btn btn-primary">Contribute on GitHub</a>
        <a href="/about" class="btn btn-secondary">About the Project</a>
      </div>
    </div>
  </div>
</BaseLayout>
