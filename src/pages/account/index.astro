---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Account | MycoSci">
  <div class="min-h-[70vh] flex items-center justify-center px-4">
    <div class="w-full max-w-md">
      <!-- Logo -->
      <div class="text-center mb-8">
        <div class="w-12 h-12 rounded bg-bio-600 flex items-center justify-center mx-auto mb-4">
          <span class="text-lab-950 font-bold text-xl">M</span>
        </div>
        <h1 class="text-2xl font-bold text-lab-100">Sign in to MycoSci</h1>
        <p class="text-lab-500 text-sm mt-2">Access your gene bank dashboard and order history</p>
      </div>

      <!-- Login Form -->
      <div class="card p-6">
        <form class="space-y-4">
          <div>
            <label for="email" class="block text-sm font-medium text-lab-300 mb-1.5">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="you@example.com"
              class="input w-full"
              required
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="password" class="block text-sm font-medium text-lab-300">Password</label>
              <a href="/account/forgot-password" class="text-xs text-bio-400 hover:text-bio-300">
                Forgot password?
              </a>
            </div>
            <input
              type="password"
              id="password"
              name="password"
              placeholder="••••••••"
              class="input w-full"
              required
            />
          </div>

          <div class="flex items-center gap-2">
            <input
              type="checkbox"
              id="remember"
              name="remember"
              class="w-4 h-4 rounded border-lab-700 bg-lab-800 text-bio-500 focus:ring-bio-500 focus:ring-offset-lab-900"
            />
            <label for="remember" class="text-sm text-lab-400">Remember me</label>
          </div>

          <button type="submit" class="btn btn-primary w-full py-2.5">
            Sign In
          </button>
        </form>

        <div class="relative my-6">
          <div class="divider"></div>
          <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 bg-lab-900 text-2xs text-lab-600 font-mono px-3">OR</span>
        </div>

        <!-- Social Login -->
        <div class="space-y-3">
          <button class="btn btn-ghost w-full py-2.5 flex items-center justify-center gap-2">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            Continue with GitHub
          </button>

          <button class="btn btn-ghost w-full py-2.5 flex items-center justify-center gap-2">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Continue with Google
          </button>
        </div>
      </div>

      <!-- Sign up link -->
      <p class="text-center text-sm text-lab-500 mt-6">
        Don't have an account?
        <a href="/account/register" class="text-bio-400 hover:text-bio-300 ml-1">
          Create one
        </a>
      </p>

      <!-- Terms -->
      <p class="text-center text-2xs text-lab-600 mt-4">
        By signing in, you agree to our
        <a href="/terms" class="text-lab-500 hover:text-lab-400">Terms of Service</a>
        and
        <a href="/privacy" class="text-lab-500 hover:text-lab-400">Privacy Policy</a>
      </p>
    </div>
  </div>
</BaseLayout>
