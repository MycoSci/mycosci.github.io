---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Get all docs to count them
const allDocs = await getCollection('docs');

// Count taxonomy entries
const taxonomyDocs = allDocs.filter(d => d.id.toLowerCase().startsWith('taxonomy'));

// Get unique phyla, classes, etc from file paths
const phyla = new Set<string>();
const classes = new Set<string>();
const orders = new Set<string>();
const families = new Set<string>();
const genera = new Set<string>();

taxonomyDocs.forEach(doc => {
  const parts = doc.id.split('/');
  if (parts[1]) phyla.add(parts[1]);
  if (parts[2]) classes.add(parts[2]);
  if (parts[3]) orders.add(parts[3]);
  if (parts[4]) families.add(parts[4]);
  if (parts[5]) genera.add(parts[5]);
});

const stats = [
  { value: taxonomyDocs.length.toString(), label: 'Species Docs' },
  { value: genera.size.toString(), label: 'Genera' },
  { value: families.size.toString(), label: 'Families' },
  { value: phyla.size.toString(), label: 'Phyla' },
];

// Major taxonomic groups to browse
const taxonomyBrowse = [
  {
    name: 'Basidiomycota',
    description: 'Club fungi including mushrooms, brackets, puffballs',
    icon: '🍄',
    href: '/docs/taxonomy/basidiomycota',
  },
  {
    name: 'Ascomycota',
    description: 'Sac fungi including morels, truffles, yeasts',
    icon: '🧫',
    href: '/docs/taxonomy/ascomycota',
  },
  {
    name: 'All Documentation',
    description: 'Browse all guides, references, and species profiles',
    icon: '📚',
    href: '/docs',
  },
];

// Popular genera to feature
const popularGenera = [
  { name: 'Amanita', href: '/docs/taxonomy/basidiomycota/agaricomycetes/agaricales/amanitaceae/amanita' },
  { name: 'Boletus', href: '/docs/taxonomy/basidiomycota/agaricomycetes/boletales/boletaceae/boletus' },
  { name: 'Agaricus', href: '/docs/taxonomy/basidiomycota/agaricomycetes/agaricales/agaricaceae/agaricus' },
  { name: 'Russula', href: '/docs/taxonomy/basidiomycota/agaricomycetes/russulales/russulaceae/russula' },
  { name: 'Lactarius', href: '/docs/taxonomy/basidiomycota/agaricomycetes/russulales/russulaceae/lactarius' },
  { name: 'Armillaria', href: '/docs/taxonomy/basidiomycota/agaricomycetes/agaricales/physalacriaceae/armillaria' },
];
---

<BaseLayout title="Species Database | MycoSci">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <!-- Header -->
    <div class="mb-12">
      <span class="label text-bio-500">SPECIES DATABASE</span>
      <h1 class="text-3xl sm:text-4xl font-bold text-lab-100 mt-2">Fungal Species Index</h1>
      <p class="text-lab-400 mt-2">Comprehensive species documentation with morphology, ecology, and taxonomy.</p>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      {stats.map((stat) => (
        <div class="card p-4 text-center">
          <div class="text-2xl sm:text-3xl font-bold text-bio-400 font-mono">{stat.value}</div>
          <div class="text-xs text-lab-500 font-mono uppercase tracking-wider mt-1">{stat.label}</div>
        </div>
      ))}
    </div>

    <!-- Browse Taxonomy -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold text-lab-100 mb-6">Browse Taxonomy</h2>
      <div class="grid md:grid-cols-3 gap-4">
        {taxonomyBrowse.map((item) => (
          <a href={item.href} class="card card-hover p-6 group">
            <div class="flex items-start gap-4">
              <span class="text-3xl">{item.icon}</span>
              <div class="flex-1">
                <h3 class="font-semibold text-lab-100 group-hover:text-bio-400 transition-colors">
                  {item.name}
                </h3>
                <p class="text-sm text-lab-500 mt-1">{item.description}</p>
              </div>
              <div class="text-lab-600 group-hover:text-bio-500 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Popular Genera -->
    <div class="mb-12">
      <h2 class="text-xl font-semibold text-lab-100 mb-6">Popular Genera</h2>
      <div class="flex flex-wrap gap-2">
        {popularGenera.map((genus) => (
          <a href={genus.href} class="badge bg-lab-800 text-lab-300 border-lab-700 hover:border-bio-600 hover:text-bio-400 transition-colors px-4 py-2">
            {genus.name}
          </a>
        ))}
        <a href="/docs/taxonomy" class="badge bg-bio-950 text-bio-400 border-bio-600 hover:bg-bio-900 transition-colors px-4 py-2">
          View All →
        </a>
      </div>
    </div>

    <!-- Search -->
    <div class="card p-6 mb-8">
      <h3 class="font-semibold text-lab-100 mb-4">Search Species</h3>
      <div class="flex flex-col sm:flex-row gap-4">
        <div class="flex-1">
          <input
            type="text"
            id="species-search"
            placeholder="Search by scientific name, common name, or genus..."
            class="input w-full"
          />
        </div>
        <a href="/docs" class="btn btn-primary">
          Browse All Docs
        </a>
      </div>
      <p class="text-xs text-lab-600 mt-3">
        Tip: Try searching for "Amanita", "morel", or "porcini"
      </p>
    </div>

    <!-- Recent additions or featured -->
    <div class="card p-8 text-center border-bio-600/30 bg-bio-950/20">
      <span class="text-4xl block mb-4">🔬</span>
      <h3 class="text-lg font-semibold text-lab-100 mb-2">Database Growing</h3>
      <p class="text-lab-400 text-sm max-w-md mx-auto mb-4">
        We're continuously adding species profiles with detailed morphological descriptions,
        ecological data, and genetic markers.
      </p>
      <a href="/docs" class="btn btn-secondary">
        Explore Documentation
      </a>
    </div>
  </div>
</BaseLayout>
