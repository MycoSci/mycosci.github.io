---
import BaseLayout from '../../layouts/BaseLayout.astro';
import speciesData from '../../../data/species.json';

interface Rec {
  slug: string; accepted: string; genus: string; family: string;
  phylum: string; commonName: string | null; edibility: string; tier: string;
}
const data = speciesData as Rec[];

const total = data.length;
const resolved = data.filter((r) => r.family).length;
const families = new Set(data.map((r) => r.family).filter(Boolean)).size;
const genera = new Set(data.map((r) => r.genus).filter(Boolean)).size;
const phyla = new Set(data.map((r) => r.phylum).filter(Boolean)).size;

const stats = [
  { value: total.toLocaleString(), label: 'Taxa' },
  { value: genera.toLocaleString(), label: 'Genera' },
  { value: families.toLocaleString(), label: 'Families' },
  { value: phyla.toLocaleString(), label: 'Phyla' },
];

// Featured = the hand-written profiles (have a common name attached).
const featured = data.filter((r) => r.commonName).slice(0, 8);

const phylaList = [...new Set(data.map((r) => r.phylum).filter(Boolean))].sort();
---

<BaseLayout title="Catalog | MycoSci">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <!-- Header -->
    <div class="border-b border-lab-800 pb-8 mb-8">
      <span class="label text-bio-500">// Catalog</span>
      <h1 class="text-3xl sm:text-4xl font-semibold text-lab-100 mt-2 tracking-tight">Fungal Species Index</h1>
      <p class="text-lab-400 mt-2 max-w-2xl">
        {total.toLocaleString()} taxa with verified taxonomy. Search by scientific name, common name, family or synonym.
      </p>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mt-6">
        {stats.map((s) => (
          <div class="flex items-baseline gap-2">
            <span class="text-xl font-mono font-semibold text-bio-400 tabular-nums">{s.value}</span>
            <span class="label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Search -->
    <div class="flex border border-lab-700 focus-within:border-bio-400 transition-colors mb-3">
      <span class="flex items-center pl-3 text-lab-500">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-5.2-5.2M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
        </svg>
      </span>
      <input id="q" type="search" autocomplete="off"
        placeholder="Search the catalog…"
        class="flex-1 bg-transparent px-3 py-3 text-sm font-mono text-lab-100 placeholder:text-lab-500 focus:outline-none" />
      <span id="status" class="flex items-center pr-4 text-2xs font-mono uppercase tracking-wider text-lab-500"></span>
    </div>

    <!-- Filter chips -->
    <div class="flex flex-wrap gap-2 mb-8" id="phyla">
      <button data-phylum="" class="badge border-bio-600 text-bio-400 bg-bio-950">All</button>
      {phylaList.map((p) => (
        <button data-phylum={p} class="badge border-lab-700 text-lab-400 hover:text-bio-400 hover:border-bio-600 transition-colors">{p}</button>
      ))}
    </div>

    <!-- Results (client-rendered) -->
    <div id="results" class="hidden"></div>

    <!-- Default: featured curated profiles -->
    <div id="featured">
      <h2 class="label mb-4">// Featured Profiles</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 border-t border-l border-lab-800">
        {featured.map((r) => (
          <a href={`/species/${r.slug}`} class="group block p-5 border-b border-r border-lab-800 hover:bg-lab-900 transition-colors">
            <div class="flex items-center justify-between mb-3">
              <span class="badge badge-bio">Curated</span>
              <span class:list={['badge', r.edibility === 'edible' ? 'badge-mycel' : (r.edibility === 'toxic' || r.edibility === 'psychoactive') ? 'badge-spore' : 'badge']}>{r.edibility}</span>
            </div>
            <h3 class="text-base font-semibold italic text-lab-100 group-hover:text-bio-400 transition-colors">{r.accepted}</h3>
            {r.commonName && <p class="text-sm text-lab-500 mt-1">{r.commonName}</p>}
            <p class="text-2xs font-mono uppercase tracking-wider text-lab-600 mt-3">{r.family}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const EDIB = ['unknown', 'edible', 'inedible', 'toxic', 'psychoactive'];
  const EDIB_CLASS = ['badge', 'badge-mycel', 'badge', 'badge-spore', 'badge-spore'];

  const qEl = document.getElementById('q') as HTMLInputElement;
  const statusEl = document.getElementById('status')!;
  const resultsEl = document.getElementById('results')!;
  const featuredEl = document.getElementById('featured')!;
  const phylaEl = document.getElementById('phyla')!;

  let index: any[] = [];   // [slug, accepted, common|0, family|0, curated, edib, phylum|0]
  let ready = false;
  let phylum = '';

  async function load() {
    statusEl.textContent = 'loading…';
    const res = await fetch('/api/search-index.json');
    index = await res.json();
    ready = true;
    statusEl.textContent = index.length.toLocaleString() + ' taxa';
    const params = new URLSearchParams(location.search);
    const q = params.get('q');
    if (q) { qEl.value = q; run(q); }
  }

  function esc(s: string) { return s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!)); }

  function run(query: string) {
    const q = query.trim().toLowerCase();
    if (!q && !phylum) {
      resultsEl.classList.add('hidden');
      featuredEl.classList.remove('hidden');
      statusEl.textContent = ready ? index.length.toLocaleString() + ' taxa' : '';
      return;
    }
    featuredEl.classList.add('hidden');
    resultsEl.classList.remove('hidden');

    const scored = [];
    for (const row of index) {
      if (phylum && row[6] !== phylum) continue;
      const [slug, accepted, common, family] = row;
      const acc = accepted.toLowerCase();
      const com = common ? String(common).toLowerCase() : '';
      const fam = family ? String(family).toLowerCase() : '';
      let score = 0;
      if (!q) score = 10; // browsing a phylum with no query
      else if (acc === q || com === q) score = 100;
      else if (acc.startsWith(q) || com.startsWith(q)) score = 80;
      else if (acc.includes(q) || com.includes(q)) score = 50;
      else if (fam.startsWith(q)) score = 30;
      else if (fam.includes(q)) score = 15;
      if (score) { if (row[4]) score += 5; scored.push([score, row]); }
      if (scored.length > 6000) break;
    }
    scored.sort((a, b) => b[0] - a[0] || a[1][1].localeCompare(b[1][1]));
    const top = scored.slice(0, 120);
    statusEl.textContent = scored.length.toLocaleString() + (phylum && !q ? ' in ' + phylum : ' matches');

    resultsEl.innerHTML = `
      <h2 class="label mb-4">// ${scored.length.toLocaleString()} result${scored.length === 1 ? '' : 's'}${scored.length > 120 ? ' · showing 120' : ''}</h2>
      <div class="border-t border-l border-lab-800 grid sm:grid-cols-2 lg:grid-cols-3">
        ${top.map(([, [slug, accepted, common, family, curated, edib]]) => `
          <a href="/species/${slug}" class="group block p-4 border-b border-r border-lab-800 hover:bg-lab-900 transition-colors">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-sm font-semibold italic text-lab-100 group-hover:text-bio-400 transition-colors truncate">${esc(accepted)}</h3>
              <span class="badge ${EDIB_CLASS[edib] || 'badge'} shrink-0">${EDIB[edib] || 'unknown'}</span>
            </div>
            ${common ? `<p class="text-xs text-lab-500 mt-1 truncate">${esc(String(common))}</p>` : ''}
            <p class="text-2xs font-mono uppercase tracking-wider text-lab-600 mt-2">${family ? esc(String(family)) : '—'}${curated ? ' · curated' : ''}</p>
          </a>`).join('')}
      </div>`;
  }

  let t: any;
  qEl.addEventListener('input', () => { clearTimeout(t); t = setTimeout(() => run(qEl.value), 120); });

  // Phylum chips link to shard browse (phylum isn't in the slim index).
  phylaEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    phylaEl.querySelectorAll('button').forEach((b) => b.className = 'badge border-lab-700 text-lab-400 hover:text-bio-400 hover:border-bio-600 transition-colors');
    btn.className = 'badge border-bio-600 text-bio-400 bg-bio-950';
    phylum = btn.getAttribute('data-phylum') || '';
    run(qEl.value);
  });

  load();
</script>
