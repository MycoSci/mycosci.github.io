---
import BaseLayout from '../../layouts/BaseLayout.astro';

const topics = [
  {
    index: '01',
    title: 'Markers & phylogeny',
    body: 'What ITS and LSU regions are, why they are the workhorse barcodes for fungi, and how to read a phylogenetic tree without overtrusting it. Reading accessions from NCBI and matching them to a name.',
  },
  {
    index: '02',
    title: 'Why cultures senesce',
    body: 'Mycelium is not immortal in a dish. We will explain senescence — the gradual loss of vigor and fruiting ability in a clonal line — what drives it, and what it looks like on the bench.',
  },
  {
    index: '03',
    title: 'Why isolates drift',
    body: 'Successive transfers select for the fastest-growing, not the best-fruiting, mycelium. We will cover sectoring, dikaryon instability and how a strain quietly changes across generations.',
  },
  {
    index: '04',
    title: 'Managing a culture bank',
    body: 'Practical methods for keeping genetics stable at home — slants, agar storage, spore prints, and disciplined transfer logs — and the real trade-offs between them. No cryo-lab required.',
  },
];

const principles = [
  ['Sourced', 'Claims tied to references — NCBI, Index Fungorum, MycoBank, peer-reviewed work — not lab folklore.'],
  ['Practical', 'Written for the bench and the spare room, with the techniques an attentive hobbyist can actually run.'],
  ['Honest', 'Where the science is unsettled or a method is debated, we say so rather than paper over it.'],
  ['Visual', 'Process diagrams and phylogenies over walls of prose, once the writing underneath is solid.'],
];
---

<BaseLayout title="Gene Science | MycoSci">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
    <!-- Header -->
    <div class="border-b border-lab-800 pb-8 mb-8">
      <div class="flex items-center gap-3">
        <span class="label text-bio-500">// Gene Science</span>
        <span class="badge badge-spore">Planned</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-semibold text-lab-100 mt-2 tracking-tight">Fungal genetics, explained.</h1>
      <p class="text-lab-400 mt-3 max-w-2xl leading-relaxed">
        The educational pillar of MycoSci: how fungal genetics actually works, written for growers and the
        curious. Markers and phylogeny, why cultures senesce, why isolates drift across generations, and how
        to keep a personal culture bank stable. This section is planned — the content is being written.
      </p>
      <div class="flex flex-wrap gap-x-6 gap-y-2 mt-5 text-2xs font-mono uppercase tracking-wider text-lab-500">
        <span>Scope · Education</span>
        <span>Markers · ITS / LSU</span>
        <span>Sources · NCBI · IF · MycoBank</span>
        <span>Status · In progress</span>
      </div>
    </div>

    <!-- What it covers -->
    <h2 class="label mb-4">// What it will cover</h2>
    <div class="border-t border-l border-lab-800 mb-12">
      {topics.map((t) => (
        <div class="border-b border-r border-lab-800 p-6">
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-2xs text-lab-600">{t.index}</span>
            <h3 class="text-base font-semibold text-lab-100">{t.title}</h3>
          </div>
          <p class="text-sm text-lab-400 mt-2 leading-relaxed">{t.body}</p>
        </div>
      ))}
    </div>

    <!-- Principles -->
    <h2 class="label mb-4">// How it's written</h2>
    <div class="border-t border-lab-800 mb-12">
      {principles.map(([k, v]) => (
        <div class="grid sm:grid-cols-[140px_1fr] gap-x-6 gap-y-1 border-b border-lab-800 py-4">
          <span class="font-mono text-2xs uppercase tracking-wider text-lab-500">{k}</span>
          <span class="text-sm text-lab-400 leading-relaxed">{v}</span>
        </div>
      ))}
    </div>

    <!-- Note: this is education, not a service -->
    <div class="border-l-2 border-bio-600 bg-bio-950/30 px-4 py-3 mb-12">
      <p class="text-sm text-lab-300">
        <span class="font-mono text-2xs uppercase tracking-wider text-bio-400">Note · </span>
        This is education, not a storage service. MycoSci does not store, cryo-preserve or sell genetics —
        it teaches you how to understand and manage your own.
      </p>
    </div>

    <!-- Contribute -->
    <div class="border border-lab-800 p-8">
      <span class="label text-bio-500">// Contribute</span>
      <h2 class="text-2xl font-semibold text-lab-100 mt-3 max-w-2xl">Write it with us.</h2>
      <p class="text-lab-400 mt-4 max-w-2xl leading-relaxed">
        This pillar is content-first: clear, sourced explainers come before any visualization. If you can
        write accurately about markers, senescence or culture maintenance, the repository is open.
      </p>
      <div class="flex flex-wrap gap-3 mt-8">
        <a href="https://github.com/MycoSci" class="btn btn-primary">Contribute on GitHub</a>
        <a href="/docs" class="btn btn-secondary">Read the Teks</a>
      </div>
    </div>
  </div>
</BaseLayout>
