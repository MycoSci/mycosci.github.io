---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getDocsNav } from '../../utils/getDocsNav';

if (import.meta.env.STARLIGHT_ENABLED) {
  return Astro.redirect('/docs/');
}

const nav = getDocsNav();
const pageModule = await import('../../content/docs/index.mdx');
const Content = pageModule.default;
const frontmatter = pageModule.frontmatter ?? {};
const pageTitle = frontmatter.title ?? 'MycoPedia';
const pageDescription = frontmatter.description ??
  'Documentation and guides for MycoSci explorers, cultivators, and researchers.';
---
<DocsLayout title={pageTitle} description={pageDescription} nav={nav}>
  <Content />
</DocsLayout>
