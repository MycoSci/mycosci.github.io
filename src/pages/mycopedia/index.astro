---
import MainLayout from '../../layouts/MainLayout.astro';

if (import.meta.env.STARLIGHT_ENABLED) {
  return Astro.redirect('/docs/');
}

const quickStartHref = '/mycopedia/quick-start/';
---
<MainLayout
  title="MycoPedia"
  description="Install the official Astro Starlight theme locally to explore the full MycoPedia documentation."
>
  <section class="my-5">
    <h1 class="mb-4">Activate the MycoPedia Docs</h1>
    <p class="lead">
      The MycoPedia reference now ships with the official
      <strong>Astro Starlight</strong> documentation theme. Install it locally to unlock the full
      navigation experience, collapsible sidebar groups, and integrated component library.
    </p>
    <div class="bg-light border rounded-3 p-4 mb-4">
      <h2 class="h5">Install Starlight</h2>
      <ol class="mb-0">
        <li>Run <code>npm install @astrojs/starlight</code> in your project.</li>
        <li>Restart the dev server with <code>npm run dev</code>.</li>
        <li>Visit <code>http://localhost:4321/docs/</code> to explore the live docs.</li>
      </ol>
    </div>
    <p>
      Need an overview while you wait? Read the
      <a href={quickStartHref}>Quick Start Guide</a> for the documentation structure, or explore the rest of
      the site using the navigation above.
    </p>
  </section>
</MainLayout>
