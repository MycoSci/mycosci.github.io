---
export async function getStaticPaths() {
  const pages = import.meta.glob('../../content/docs/**/*.{md,mdx}');
  return Object.keys(pages)
    .map(path => {
      const relative = path
        .replace('../../content/docs/', '')
        .replace(/\.(md|mdx)$/, '')
        .replace(/\/index$/, '');
      if (!relative) return undefined;
      return { params: { slug: relative } };
    })
    .filter((entry): entry is { params: { slug: string } } => Boolean(entry));
}

const slugParam = Astro.params.slug;
const slugPath = Array.isArray(slugParam) ? slugParam.join('/') : slugParam ?? '';

const withTrailingSlash = (value: string) => (value.endsWith('/') ? value : `${value}/`);
const target = slugPath ? `/docs/${slugPath}` : '/docs/';
return Astro.redirect(withTrailingSlash(target));
---
