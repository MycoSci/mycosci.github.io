---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Cart | MycoSci">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <!-- Header -->
    <div class="mb-8">
      <span class="label text-bio-500">SHOPPING CART</span>
      <h1 class="text-3xl font-bold text-lab-100 mt-2">Your Cart</h1>
    </div>

    <!-- Cart contents (rendered client-side) -->
    <div id="cart-contents">
      <div class="card p-12 text-center">
        <span class="text-4xl block mb-4 opacity-30">🛒</span>
        <p class="text-lab-400">Loading cart...</p>
      </div>
    </div>

    <!-- Empty cart template -->
    <template id="empty-cart-template">
      <div class="card p-12 text-center">
        <span class="text-5xl block mb-4 opacity-30">🛒</span>
        <p class="text-lab-400 mb-4">Your cart is empty.</p>
        <a href="/shop" class="btn btn-primary">Browse Shop</a>
      </div>
    </template>

    <!-- Cart item template -->
    <template id="cart-item-template">
      <div class="cart-item card p-4 mb-4 flex gap-4">
        <div class="w-20 h-20 bg-lab-800 rounded flex-shrink-0 flex items-center justify-center overflow-hidden">
          <img class="item-image w-full h-full object-cover hidden" alt="" />
          <span class="item-placeholder text-2xl opacity-30">🧫</span>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="item-name font-medium text-lab-100 truncate"></h3>
          <p class="item-price text-sm text-bio-400 font-mono mt-1"></p>
        </div>
        <div class="flex items-center gap-3">
          <div class="flex items-center border border-lab-700 rounded">
            <button class="qty-decrease w-8 h-8 flex items-center justify-center text-lab-400 hover:text-lab-100 transition-colors">−</button>
            <span class="item-qty w-8 text-center text-sm text-lab-200"></span>
            <button class="qty-increase w-8 h-8 flex items-center justify-center text-lab-400 hover:text-lab-100 transition-colors">+</button>
          </div>
          <button class="remove-item text-lab-600 hover:text-spore-400 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
        </div>
      </div>
    </template>
  </div>
</BaseLayout>

<script>
  interface CartItem {
    id: number;
    name: string;
    price: string;
    image?: string;
    quantity: number;
  }

  interface Cart {
    items: CartItem[];
    total: number;
  }

  function getCart(): Cart {
    try {
      return JSON.parse(localStorage.getItem('mycosci_cart') || '{"items":[],"total":0}');
    } catch {
      return { items: [], total: 0 };
    }
  }

  function saveCart(cart: Cart) {
    localStorage.setItem('mycosci_cart', JSON.stringify(cart));
    window.dispatchEvent(new CustomEvent('cart-updated', { detail: cart }));
  }

  function parsePrice(price: string): number {
    return parseFloat(price.replace(/[^0-9.]/g, '')) || 0;
  }

  function formatPrice(amount: number): string {
    return '$' + amount.toFixed(2);
  }

  function calculateTotal(items: CartItem[]): number {
    return items.reduce((sum, item) => sum + (parsePrice(item.price) * item.quantity), 0);
  }

  function renderCart() {
    const container = document.getElementById('cart-contents');
    const emptyTemplate = document.getElementById('empty-cart-template') as HTMLTemplateElement;
    const itemTemplate = document.getElementById('cart-item-template') as HTMLTemplateElement;

    if (!container || !emptyTemplate || !itemTemplate) return;

    const cart = getCart();

    if (cart.items.length === 0) {
      container.innerHTML = '';
      container.appendChild(emptyTemplate.content.cloneNode(true));
      return;
    }

    container.innerHTML = '';

    // Render items
    const itemsContainer = document.createElement('div');
    itemsContainer.className = 'mb-6';

    cart.items.forEach(item => {
      const itemEl = itemTemplate.content.cloneNode(true) as DocumentFragment;
      const wrapper = itemEl.querySelector('.cart-item') as HTMLElement;

      const img = wrapper.querySelector('.item-image') as HTMLImageElement;
      const placeholder = wrapper.querySelector('.item-placeholder') as HTMLElement;
      const name = wrapper.querySelector('.item-name') as HTMLElement;
      const price = wrapper.querySelector('.item-price') as HTMLElement;
      const qty = wrapper.querySelector('.item-qty') as HTMLElement;
      const decrease = wrapper.querySelector('.qty-decrease') as HTMLButtonElement;
      const increase = wrapper.querySelector('.qty-increase') as HTMLButtonElement;
      const remove = wrapper.querySelector('.remove-item') as HTMLButtonElement;

      if (item.image) {
        img.src = item.image;
        img.classList.remove('hidden');
        placeholder.classList.add('hidden');
      }

      name.textContent = item.name;
      price.textContent = item.price;
      qty.textContent = item.quantity.toString();

      wrapper.dataset.id = item.id.toString();

      decrease.addEventListener('click', () => updateQuantity(item.id, item.quantity - 1));
      increase.addEventListener('click', () => updateQuantity(item.id, item.quantity + 1));
      remove.addEventListener('click', () => removeItem(item.id));

      itemsContainer.appendChild(itemEl);
    });

    container.appendChild(itemsContainer);

    // Summary
    const summary = document.createElement('div');
    summary.className = 'card p-6';
    summary.innerHTML = `
      <div class="flex justify-between items-center mb-4">
        <span class="text-lab-400">Subtotal</span>
        <span class="text-xl font-bold text-bio-400 font-mono">${formatPrice(cart.total)}</span>
      </div>
      <div class="text-xs text-lab-600 mb-6">Shipping calculated at checkout</div>
      <button id="checkout-btn" class="btn btn-primary w-full py-3">
        Proceed to Checkout
      </button>
      <div class="flex justify-center gap-4 mt-4">
        <a href="/shop" class="text-sm text-lab-500 hover:text-bio-400">Continue Shopping</a>
        <button id="clear-cart-btn" class="text-sm text-lab-600 hover:text-spore-400">Clear Cart</button>
      </div>
    `;

    container.appendChild(summary);

    // Wire up summary buttons
    document.getElementById('checkout-btn')?.addEventListener('click', () => {
      alert('Checkout coming soon! This will connect to WooCommerce.');
    });

    document.getElementById('clear-cart-btn')?.addEventListener('click', () => {
      if (confirm('Clear all items from your cart?')) {
        saveCart({ items: [], total: 0 });
        renderCart();
      }
    });
  }

  function updateQuantity(id: number, newQty: number) {
    const cart = getCart();

    if (newQty <= 0) {
      cart.items = cart.items.filter(item => item.id !== id);
    } else {
      const item = cart.items.find(i => i.id === id);
      if (item) item.quantity = newQty;
    }

    cart.total = calculateTotal(cart.items);
    saveCart(cart);
    renderCart();
  }

  function removeItem(id: number) {
    const cart = getCart();
    cart.items = cart.items.filter(item => item.id !== id);
    cart.total = calculateTotal(cart.items);
    saveCart(cart);
    renderCart();
  }

  // Initial render
  document.addEventListener('DOMContentLoaded', renderCart);
</script>
