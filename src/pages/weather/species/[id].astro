---
/**
 * /weather/species/<id> — one species: its map, how far that map has been
 * checked, and what it gets confused with.
 *
 * Two things earn their place here over the model's own parameters. The first
 * is the back-test, because "checked against real records" and "not checked
 * yet" is the single largest difference between two maps that look identical.
 * The second is the look-alike material, which is the only safety content on
 * this site a reader can actually act on: nine of these profiles carry a
 * sourced review, and where that review found the literature in genuine
 * disagreement — the Gyromitra parboiling question, the angel-wings toxin —
 * the disagreement is rendered AS a disagreement. Flattening either into a
 * confident sentence is the most dangerous thing this page could do.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Legend from '../../../components/weather/Legend.astro';
import Plate from '../../../components/weather/Plate.astro';
import {
  catalogUrl,
  currentRun,
  evidentialStatus,
  lookAlikeParts,
  manifestBands,
  resolveResearchRefs,
  prettyField,
  noteBody,
  notBackTested,
  profiles,
  validationGenerated,
} from '../../../lib/weather';

export function getStaticPaths() {
  return Object.values(profiles).map((p) => ({ params: { id: p.id }, props: { profile: p } }));
}

const { profile } = Astro.props;
const id = profile.id;
const status = evidentialStatus(id);
const entry = status.entry;
const run = currentRun;
const todaySp = run?.manifest.species?.find((s) => s.id === id);

// The state of the evidence is stated whether or not today's run happened to
// render this species. Showing it only on the days a map exists would let a
// reader meet the species on a quiet day and never learn its ranking is
// untested.
const untested = notBackTested(id);

const cond = profile.fruiting_conditions ?? {};
const season = profile.season ?? {};
const cal = profile.calibration ?? {};
const fitted = (cal.fitted ?? []).filter((x: unknown) => typeof x === 'string') as string[];
const unfitted = (cal.unfitted ?? []).filter((x: unknown) => typeof x === 'string') as string[];
const calDetail = (
  [
    ['rule', ''],
    ['evidence', 'Evidence.'],
    ['caveat', 'Caveat.'],
    ['was', 'Previously.'],
  ] as const
)
  .map(([k, lead]) => ({ lead, text: typeof cal[k] === 'string' ? cal[k].trim() : '' }))
  .filter((d) => d.text);

// The sourced review behind the look-alike prose, where one exists. Conflicts
// and gaps are rendered as conflicts and gaps; nothing here is summarised into
// a verdict the sources did not reach.
const research = profile.research ?? null;
const ref = (t?: string) => resolveResearchRefs(t ?? '', research);

const looks = (profile.look_alikes ?? []).map((raw) => lookAlikeParts(ref(raw)));
const anyBare = looks.some((l) => l.bare);
const sources = (research?.sources ?? []).map((src) => ({ ...src, supports: ref(src.supports) }));
const conflicts = (research?.conflicts ?? []).map((c) => ref(c));
const gaps = (research?.gaps ?? []).map((g) => ref(g));

const conditions: Array<[string, string]> = [
  [
    'Fruiting temperature',
    `${cond.air_temp_min_f ?? '—'}–${cond.air_temp_max_f ?? '—'}°F air, optimum ${cond.air_temp_optimal_f ?? '—'}°F`,
  ],
  ['Soil temperature', `${cond.soil_temp_min_f ?? '—'}–${cond.soil_temp_max_f ?? '—'}°F`],
  [
    'Incubation after wet-up',
    `${cond.incubation_days_min ?? '—'}–${cond.incubation_days_max ?? '—'} days`,
  ],
  ['Temperature trigger', String(cond.temp_trend_trigger ?? '—')],
  ['Elevation', `${cond.elevation_min_ft ?? '—'}–${cond.elevation_max_ft ?? '—'} ft`],
  [
    'Associates with',
    (profile.association ?? []).map((a: string) => a.replace(/_/g, ' ')).join(', ') || '—',
  ],
];

const name = profile.common_name ?? id;
const edibility = (profile.edibility ?? '').replace(/_/g, ' ');
const catalogHref = catalogUrl(profile);
---

<BaseLayout
  title={`${name} — fruiting weather | MycoSci`}
  description={`Where to look for ${name} in Oregon today, how far that prediction has been checked, and what it gets confused with.`}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
    <!-- Header -->
    <div class="border-b border-lab-800 pb-8 mb-8">
      <div class="flex flex-wrap items-center gap-3">
        <a href="/weather" class="label text-bio-500 hover:text-bio-400">// Fruiting weather</a>
        <span
          class:list={['badge', status.kind === 'measured' ? 'badge-bio' : 'badge']}
        >
          {status.label}
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-semibold text-lab-100 mt-2 tracking-tight">{name}</h1>
      <p class="text-lab-400 mt-3 leading-relaxed">
        <i>{profile.scientific_name}</i> · {(profile.substrate ?? '').replace(/_/g, ' ')} ·
        considered {edibility || 'unrated'} where correctly identified
      </p>
      <div class="flex flex-wrap gap-x-6 gap-y-2 mt-3">
        {looks.length > 0 && (
          <a
            href="#look-alikes"
            class="font-mono text-2xs uppercase tracking-wider text-bio-400 hover:text-bio-300"
          >
            Look-alikes and how to separate them ↓
          </a>
        )}
        {catalogHref && (
          <a
            href={catalogHref}
            class="font-mono text-2xs uppercase tracking-wider text-bio-400 hover:text-bio-300"
          >
            Taxonomy, morphology and edibility in the catalog →
          </a>
        )}
      </div>
    </div>

    <!-- Publication status: stated before any map, on every day. -->
    {
      untested && (
        <div class="border-l-2 border-spore-600 bg-spore-600/5 px-4 py-4 mb-8">
          <p class="font-mono text-2xs uppercase tracking-wider text-spore-400">
            Ranking not back-tested
          </p>
          <p class="text-sm text-lab-300 mt-2 leading-relaxed">
            The map below is the model's real output for {name}, scored the same way as every
            other map in this section. What has not happened is the check on how well those
            scores rank ground against real occurrence records. {noteBody(untested.note)}
          </p>
          {typeof untested.max_observed_score === 'number' && (
            <p class="text-sm text-lab-400 mt-2 leading-relaxed">
              For scale: the highest score any real record of this species has ever sat on is{' '}
              <span class="font-mono text-lab-200">{untested.max_observed_score.toFixed(3)}</span>{typeof todaySp?.max_score === 'number' ? `, and today's map for it peaks at ${todaySp.max_score.toFixed(3)}.` : '.'}
            </p>
          )}
        </div>
      )
    }

    <!-- Today's plate -->
    {
      todaySp && run ? (
        <>
          <Plate species={todaySp} run={run} headline={false} />
          <div class="mt-6">
            <Legend bands={manifestBands(run.manifest, id)} />
          </div>
        </>
      ) : (
        <div class="border-l-2 border-lab-600 bg-lab-900 px-4 py-4">
          <p class="font-mono text-2xs uppercase tracking-wider text-lab-400">
            Not in the current run
          </p>
          <p class="text-sm text-lab-300 mt-2 leading-relaxed">
            The run for {run?.target_date ?? 'the current day'} did not render this species, so
            there is no map for it today. That is a gap in coverage, not a statement about
            fruiting.
          </p>
        </div>
      )
    }

    <!-- Evidential status -->
    <section class="mt-12">
      <h2 class="label mb-4">// How far this map has been checked</h2>
      <div class="card p-6">
        <p class="text-sm text-lab-300 leading-relaxed">
          <strong class="text-lab-100">{status.label}.</strong> {noteBody(status.detail)}
        </p>
      </div>

      {
        entry && (
          <dl class="border-t border-lab-800 mt-6">
            {(
              [
                ['Records used', String(entry.n_obs ?? '—')],
                ['Effort-matched controls', String(entry.n_control ?? '—')],
                ['Control set', entry.derived_from ?? '—'],
                [
                  'Highest score under any real record',
                  (entry.max_observed_score ?? 0).toFixed(3),
                ],
                ['Analysis dated', validationGenerated || '—'],
              ] as Array<[string, string]>
            ).map(([k, v]) => (
              <div class="grid sm:grid-cols-[280px_1fr] gap-x-6 gap-y-1 border-b border-lab-800 py-3">
                <dt class="font-mono text-2xs uppercase tracking-wider text-lab-500">{k}</dt>
                <dd class="font-mono text-xs text-lab-300">{v}</dd>
              </div>
            ))}
          </dl>
        )
      }

      {
        status.kind === 'measured' && entry?.bands?.length ? (
          <div class="mt-8">
            <h3 class="text-lg font-semibold text-lab-100">What the measurement found</h3>
            <ul class="mt-4 space-y-4">
              {entry.bands.map((b) => (
                <li class="border-l-2 border-bio-600 pl-4">
                  <span class="font-mono text-lg text-bio-400 tabular-nums">
                    {b.enrichment.toFixed(1)}×
                  </span>
                  {/* The record's own sentence, verbatim. Paraphrasing an interval is
                      how a cumulative "at or above 0.05" quietly becomes a bounded
                      "0.05 to 0.50", so the wording that ships is the wording that
                      was measured. */}
                  <p class="text-sm text-lab-400 mt-1.5 leading-relaxed">{b.meaning}</p>
                </li>
              ))}
            </ul>
            <p class="text-sm text-lab-400 mt-5 leading-relaxed">
              Each multiplier compares real records against effort-matched controls — places
              somebody searched in the same season and recorded a different fungus — so it is a
              ratio against ground people search, not a percentage chance of finding one. No
              percentage exists in this data at any sample size, because the days people looked
              and found nothing are recorded nowhere.
            </p>
            <p class="text-xs text-lab-500 mt-3 leading-relaxed">
              These cut points are the standing measurement for this species, dated{' '}
              {validationGenerated || 'unknown'}. They were not attached to the current run, so no
              band name is printed on the map above — read the scores off the ramp and compare
              them against the figures here.
            </p>
          </div>
        ) : status.kind === 'excluded' ? (
          <div class="mt-8">
            <h3 class="text-lg font-semibold text-lab-100">What that blocks, and what it doesn't</h3>
            <p class="text-sm text-lab-400 mt-3 leading-relaxed">
              Note what that is a statement about. It is about the <em>records</em>, whose
              coordinates are deliberately scrambled before anyone can read them; it is not a
              finding about the map. The map above is the model's real output, ranked the same way
              as every other map here. Nobody can yet say how well that ranking holds up, because
              the data that would test it has been blurred for good reasons.
            </p>
          </div>
        ) : (
          <div class="mt-8">
            <h3 class="text-lg font-semibold text-lab-100">Why there is no ratio yet</h3>
            <p class="text-sm text-lab-400 mt-3 leading-relaxed">
              <strong class="text-lab-200">Untested, not failed.</strong> An analysis that could
              not resolve is not the same as one that resolved badly, and treating the two alike
              would convert an absence of evidence into evidence of absence. The map is the
              model's real answer for this species; what is missing is the number that would tell
              you how much to trust its ranking.
            </p>
          </div>
        )
      }
    </section>

    <!-- Calibration -->
    {
      (fitted.length > 0 || unfitted.length > 0 || calDetail.length > 0) && (
        <section class="mt-12">
          <h2 class="label mb-4">// Which of these numbers were measured</h2>
          <div class="card p-6">
            {fitted.length ? (
              <p class="text-sm text-lab-300 leading-relaxed">
                <strong class="text-lab-100">Fitted to data:</strong>{' '}
                {fitted.map(prettyField).join(', ')}
              </p>
            ) : (
              <p class="text-sm text-lab-300 leading-relaxed">
                <strong class="text-lab-100">Fitted to data: nothing.</strong> Every number the
                model uses for this species came from the literature rather than from Oregon
                observations.
              </p>
            )}
            {unfitted.length > 0 && (
              /* "unfitted" means exactly what it says: not fitted. For one species the
                 record goes on to explain that its priors were tested and beat their
                 data-derived replacements; for another it means nobody has tried.
                 Calling the list "measured but left alone" would carry the first story
                 onto the second, so the label stays literal. */
              <p class="text-sm text-lab-300 leading-relaxed mt-3">
                <strong class="text-lab-100">Not fitted:</strong>{' '}
                {unfitted.map(prettyField).join(', ')} — literature values, not numbers this data
                chose. Whether they have been tested at all is in the record below.
              </p>
            )}
            {typeof cal.measured === 'string' && cal.measured.trim() && (
              <p class="text-xs text-lab-500 mt-3">Calibration dated {cal.measured.trim()}.</p>
            )}

            {calDetail.length > 0 && (
              <details class="mt-5 border-t border-lab-800 pt-4">
                <summary class="cursor-pointer font-mono text-2xs uppercase tracking-wider text-bio-400 hover:text-bio-300">
                  The calibration record, in the harness's own words
                </summary>
                <div class="mt-4 space-y-3">
                  {calDetail.map((d) => (
                    <p class="text-sm text-lab-400 leading-relaxed">
                      {d.lead && <strong class="text-lab-200">{d.lead}</strong>} {d.text}
                    </p>
                  ))}
                </div>
              </details>
            )}
          </div>
        </section>
      )
    }

    <!-- Model parameters -->
    <section class="mt-12">
      <h2 class="label mb-4">// What the model looks for</h2>
      <dl class="border-t border-lab-800">
        {
          conditions.map(([k, v]) => (
            <div class="grid sm:grid-cols-[240px_1fr] gap-x-6 gap-y-1 border-b border-lab-800 py-3">
              <dt class="font-mono text-2xs uppercase tracking-wider text-lab-500">{k}</dt>
              <dd class="text-sm text-lab-300">{v}</dd>
            </div>
          ))
        }
      </dl>
      {season.notes && <p class="text-sm text-lab-400 mt-5 leading-relaxed">{season.notes}</p>}
    </section>

    <!-- ----------------------------------------------------------------
         Look-alikes.

         The one hard caveat on this site lives here, as a line rather than
         a panel: a map cannot tell you what is in your hand. Everything
         under it is the useful half — what the sources actually say about
         each confusion and how they say to separate it — which protects a
         reader in a way a disclaimer cannot.
    ----------------------------------------------------------------- -->
    {
      looks.length > 0 && (
        <section class="mt-12" id="look-alikes">
          <h2 class="label mb-4">// Look-alikes, and how to separate them</h2>
          <div class="border-l-2 border-red-500 bg-red-500/10 px-4 py-3">
            <p class="text-sm text-lab-100 leading-relaxed">
              <strong>This site does not identify mushrooms.</strong> What follows is what the
              sources say about the confusions people actually make with {name} — read it with a
              key in your hand, not instead of one.
            </p>
          </div>

          <ul class="mt-6 space-y-5">
            {looks.map((l) => (
              <li
                class:list={[
                  'border-l-2 pl-4 py-1',
                  l.bare ? 'border-spore-600' : 'border-lab-700',
                ]}
              >
                {l.lead && (
                  <p class="text-base font-semibold text-lab-100 leading-snug">{l.lead}</p>
                )}
                {l.paragraphs.map((para, i) => (
                  <p
                    class:list={[
                      'text-sm leading-relaxed',
                      l.bare ? 'text-lab-400' : 'text-lab-300',
                      l.lead || i > 0 ? 'mt-2' : '',
                    ]}
                  >
                    {para}
                  </p>
                ))}
                {l.bare && (
                  <span class="block font-mono text-2xs uppercase tracking-wider text-spore-400 mt-2">
                    Identifier only — no description, symptoms or distinguishing feature recorded
                  </span>
                )}
              </li>
            ))}
          </ul>

          {anyBare && (
            <p class="text-sm text-lab-400 mt-5 leading-relaxed">
              An entry marked <em>identifier only</em> is a name this dataset has not yet
              described. It tells you a confusion exists and nothing about how to resolve it, and
              inventing the missing detail here would be putting words about edibility into a
              dataset that never said them. Use a regional field guide for those.
            </p>
          )}

          {research && (
            <div class="mt-8 border-t border-lab-800 pt-6">
              <p class="font-mono text-2xs uppercase tracking-wider text-lab-500">
                Where this came from
              </p>
              <p class="text-sm text-lab-400 mt-2 leading-relaxed">
                Reviewed {research.reviewed ?? 'undated'} against {research.independent_source_count ?? sources.length}{' '}
                independent sources.
                {research.confidence && (
                  <>
                    {' '}
                    <strong class="text-lab-200">Confidence:</strong> {research.confidence}
                  </>
                )}
              </p>

              {conflicts.length > 0 && (
                <div class="mt-6">
                  <h3 class="text-lg font-semibold text-spore-400">
                    Where the sources disagree
                  </h3>
                  <p class="text-sm text-lab-400 mt-2 leading-relaxed">
                    {conflicts.length === 1 ? 'This is' : 'These are'} recorded unresolved, on
                    purpose. Reputable sources contradict each other here, and picking a winner
                    would hand you a confidence the literature does not have.
                  </p>
                  <ul class="mt-4 space-y-4">
                    {conflicts.map((c) => (
                      <li class="border-l-2 border-spore-600 pl-4 text-sm text-lab-300 leading-relaxed">
                        {c}
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {gaps.length > 0 && (
                <div class="mt-8">
                  <h3 class="text-lg font-semibold text-lab-100">What the review could not establish</h3>
                  <p class="text-sm text-lab-400 mt-2 leading-relaxed">
                    Absences in the written record, listed so nobody reads a short look-alike list
                    as evidence that few confusions exist.
                  </p>
                  <ul class="mt-4 space-y-3">
                    {gaps.map((g) => (
                      <li class="border-l-2 border-lab-700 pl-4 text-sm text-lab-400 leading-relaxed">
                        {g}
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {sources.length > 0 && (
                <details class="mt-8 card p-6">
                  <summary class="cursor-pointer font-mono text-2xs uppercase tracking-wider text-bio-400 hover:text-bio-300">
                    The {sources.length} sources, and what each one supports
                  </summary>
                  <ol class="mt-5 space-y-4">
                    {sources.map((src) => (
                      <li class="border-l-2 border-lab-700 pl-4">
                        <p class="text-sm text-lab-200 leading-snug">
                          {src.url ? (
                            <a
                              href={src.url}
                              rel="nofollow noopener"
                              class="text-bio-400 hover:text-bio-300"
                            >
                              {src.title ?? src.publication ?? src.url}
                            </a>
                          ) : (
                            src.title ?? src.publication
                          )}
                        </p>
                        <p class="text-2xs font-mono text-lab-500 mt-1">
                          {[src.authors, src.publication, src.year].filter(Boolean).join(' · ')}
                        </p>
                        {src.supports && (
                          <p class="text-sm text-lab-400 mt-2 leading-relaxed">{src.supports}</p>
                        )}
                      </li>
                    ))}
                  </ol>
                  {research.method && (
                    <p class="text-xs text-lab-500 mt-6 leading-relaxed border-t border-lab-800 pt-4">
                      <strong class="text-lab-400">Method.</strong> {research.method}
                    </p>
                  )}
                </details>
              )}
            </div>
          )}
        </section>
      )
    }

    {
      profile.special_notes && (
        <section class="mt-12">
          <h2 class="label mb-4">// Notes from the model</h2>
          <details class="card p-6">
            <summary class="cursor-pointer font-mono text-2xs uppercase tracking-wider text-bio-400 hover:text-bio-300">
              Implementation and publication notes for this species
            </summary>
            <p class="text-sm text-lab-400 mt-4 leading-relaxed">{profile.special_notes}</p>
          </details>
        </section>
      )
    }
  </div>
</BaseLayout>
