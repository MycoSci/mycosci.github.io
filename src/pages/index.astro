---
import BaseLayout from '../layouts/BaseLayout.astro';
import speciesData from '../../data/species.json';

// Figures derived live from the canonical dataset so they never drift.
const taxa = speciesData as { unresolved?: boolean; synonyms: string[] }[];
const accepted = taxa.filter((t) => !t.unresolved).length;
const synonyms = taxa.reduce((n, t) => n + (t.synonyms?.length || 0), 0);

const stats = [
  { value: accepted.toLocaleString(), label: 'Accepted Taxa' },
  { value: synonyms.toLocaleString(), label: 'Synonyms Mapped' },
  { value: '100%', label: 'Open Source' },
  { value: 'Static', label: 'Free JSON API' },
];

const pillars = [
  {
    index: '01',
    title: 'Catalog',
    status: 'ACTIVE',
    body: 'Every fungal species with a stable URL, verified taxonomy, and sourced detail. Accurate skeleton everywhere; deep where we have data.',
    href: '/database',
  },
  {
    index: '02',
    title: 'Deep Search',
    status: 'ACTIVE',
    body: 'Faceted lookup across taxonomy, morphology, ecology, edibility and distribution. Prebuilt index, fully client-side — works on a static build.',
    href: '/database',
  },
  {
    index: '03',
    title: 'Cultivation & Lab Teks',
    status: 'ACTIVE',
    body: 'Opinionated, reproducible guides: agar, liquid culture, grain, fruiting, contamination ID, sterile technique. Process diagrams over prose.',
    href: '/docs',
  },
  {
    index: '04',
    title: 'Gene Science',
    status: 'PLANNED',
    body: 'Visualize ITS/LSU markers, phylogeny, culture senescence and isolate drift. The part most mycology references never reach.',
    href: '/docs',
  },
];
---

<BaseLayout title="MycoSci — Open Fungal Catalog">
  <!-- Hero -->
  <section class="relative border-b border-lab-800 overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-40"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-lab-950"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-20 pb-16">
      <div class="flex items-center gap-3 mb-8">
        <span class="status-dot status-active"></span>
        <span class="label">Open Source · Community Built · Free Forever</span>
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-semibold text-lab-100 tracking-tight max-w-4xl text-balance">
        The fungal kingdom,<br class="hidden sm:block" /> fully catalogued and machine-readable.
      </h1>

      <p class="text-lg text-lab-400 max-w-2xl mt-6 leading-relaxed">
        A free, open catalog of every fungal species — taxonomy, morphology, ecology, edibility and
        cultivation. Each page is also a static JSON endpoint, so the whole catalog doubles as a free API.
      </p>

      <!-- Search -->
      <form action="/database" method="get" class="flex max-w-xl mt-10 border border-lab-700 focus-within:border-bio-400 transition-colors">
        <span class="flex items-center pl-3 text-lab-500">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-5.2-5.2M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
          </svg>
        </span>
        <input
          type="search"
          name="q"
          aria-label="Search the species catalog"
          placeholder={`Search ${accepted.toLocaleString()} taxa — e.g. Amanita muscaria`}
          class="flex-1 bg-transparent px-3 py-3 text-sm font-mono text-lab-100 placeholder:text-lab-500 focus:outline-none"
        />
        <button type="submit" class="btn btn-primary px-5">Search</button>
      </form>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-12">
        {stats.map((stat, i) => (
          <div class="flex items-center gap-4">
            {i > 0 && <span class="text-lab-700">·</span>}
            <div class="flex items-baseline gap-2">
              <span class="text-xl font-mono font-semibold text-bio-400 tabular-nums">{stat.value}</span>
              <span class="label">{stat.label}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pillars -->
  <section class="border-b border-lab-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
      <div class="flex items-baseline justify-between mb-10">
        <h2 class="label text-lab-400">// Program</h2>
        <span class="label">04 Pillars</span>
      </div>

      <div class="grid sm:grid-cols-2 border-t border-l border-lab-800">
        {pillars.map((p) => (
          <a href={p.href} class="group block p-6 border-b border-r border-lab-800 hover:bg-lab-900 transition-colors">
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-2xs text-lab-600">{p.index}</span>
              <span class:list={[
                'badge',
                p.status === 'ACTIVE' ? 'badge-mycel' : p.status === 'BUILDING' ? 'badge-bio' : 'badge'
              ]}>{p.status}</span>
            </div>
            <h3 class="text-lg font-semibold text-lab-100 group-hover:text-bio-400 transition-colors">{p.title}</h3>
            <p class="text-sm text-lab-400 mt-2 leading-relaxed">{p.body}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- API -->
  <section class="border-b border-lab-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <span class="label text-bio-500">// Free API</span>
        <h2 class="text-2xl sm:text-3xl font-semibold text-lab-100 mt-3">Every page is an endpoint.</h2>
        <p class="text-lab-400 mt-4 leading-relaxed">
          The catalog is statically generated and served from GitHub Pages — no servers, no keys, no rate limits.
          Append <code class="text-bio-400 font-mono">.json</code> to any species URL and get structured data back.
          Sharded indexes let you pull whole genera or families in one request.
        </p>
        <div class="flex flex-wrap gap-3 mt-6">
          <a href="/api" class="btn btn-secondary">API Reference</a>
          <a href="/database" class="btn btn-ghost">Browse Catalog →</a>
        </div>
      </div>

      <div class="card font-mono text-xs">
        <div class="flex items-center gap-2 px-4 py-2.5 border-b border-lab-800 text-lab-500">
          <span class="status-dot status-active"></span>
          <span class="tracking-wider">GET /species/amanita-muscaria.json</span>
        </div>
        <pre class="p-4 overflow-x-auto text-lab-300 leading-relaxed"><code>{`{
  "slug": "amanita-muscaria",
  "accepted": "Amanita muscaria",
  "genus": "Amanita",
  "family": "Amanitaceae",
  "order": "Agaricales",
  "class": "Agaricomycetes",
  "phylum": "Basidiomycota",
  "commonName": "Fly Agaric",
  "edibility": "toxic",
  "synonyms": ["Agaricus muscarius", ...],
  "tier": "curated"
}`}</code></pre>
      </div>
    </div>
  </section>

  <!-- Contribute -->
  <section>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
      <div class="border border-lab-800 p-8 sm:p-12">
        <span class="label text-bio-500">// Community</span>
        <h2 class="text-2xl sm:text-3xl font-semibold text-lab-100 mt-3 max-w-2xl">
          Built in the open. Owned by no one.
        </h2>
        <p class="text-lab-400 mt-4 max-w-2xl leading-relaxed">
          MycoSci is a volunteer effort to make accurate mycology free and permanent. Every species
          profile, tek and dataset is open. Found an error, have a source, want to write a profile —
          the repository is yours to edit.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="https://github.com/MycoSci" class="btn btn-primary">Contribute on GitHub</a>
          <a href="/about" class="btn btn-secondary">About the Project</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
