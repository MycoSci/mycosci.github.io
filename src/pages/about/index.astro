---
import BaseLayout from '../../layouts/BaseLayout.astro';
import speciesData from '../../../data/species.json';
const total = (speciesData as any[]).length;

const pillars = [
  { i: '01', title: 'Catalog', body: 'Every fungal species with a stable URL, verified taxonomy, and sourced detail — and a JSON twin for every page.' },
  { i: '02', title: 'Deep Search', body: 'Faceted, client-side lookup across taxonomy, edibility, ecology and more. Works on a static build.' },
  { i: '03', title: 'Cultivation & Lab Teks', body: 'Reproducible, safety-conscious guides: sterile technique, agar, liquid culture, grain, bulk, fruiting, contamination ID.' },
  { i: '04', title: 'Gene Science', body: 'Planned: ITS/LSU markers, phylogeny, culture senescence and isolate drift — the part most references never reach.' },
];

const notGoals = ['No accounts or logins', 'No paywalls or subscriptions', 'No ads or tracking', 'No selling your data'];
---

<BaseLayout title="About | MycoSci" description="MycoSci is a free, open, community-built catalog of the fungal kingdom — every species and every tek, machine-readable.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
    <div class="border-b border-lab-800 pb-8 mb-10">
      <span class="label text-bio-500">// About</span>
      <h1 class="text-3xl sm:text-4xl font-semibold text-lab-100 mt-2 tracking-tight">An open catalog of the fungal kingdom.</h1>
      <p class="text-lab-400 mt-4 max-w-2xl leading-relaxed">
        MycoSci is a free, community-built reference for mycology. The goal is simple: take the knowledge of
        fungi — taxonomy, edibility, ecology, cultivation — that is so often scattered, paywalled, or hoarded,
        and make it accurate, permanent, and open to everyone. {total.toLocaleString()} taxa and counting,
        each one also a machine-readable endpoint.
      </p>
    </div>

    <h2 class="label mb-4">// What it is</h2>
    <div class="grid sm:grid-cols-2 border-t border-l border-lab-800 mb-12">
      {pillars.map((p) => (
        <div class="border-b border-r border-lab-800 p-6">
          <span class="font-mono text-2xs text-lab-600">{p.i}</span>
          <h3 class="text-lg font-semibold text-lab-100 mt-2">{p.title}</h3>
          <p class="text-sm text-lab-400 mt-2 leading-relaxed">{p.body}</p>
        </div>
      ))}
    </div>

    <div class="grid sm:grid-cols-2 gap-8 mb-12">
      <div>
        <h2 class="label mb-3">// What it isn't</h2>
        <ul class="space-y-2">
          {notGoals.map((n) => (
            <li class="flex items-center gap-3 text-sm text-lab-300">
              <span class="status-dot bg-spore-500"></span>{n}
            </li>
          ))}
        </ul>
        <p class="text-sm text-lab-500 mt-4 leading-relaxed">
          It's a static site served from GitHub Pages. Contributing happens through the repository, not an account.
        </p>
      </div>
      <div>
        <h2 class="label mb-3">// Safety</h2>
        <p class="text-sm text-lab-300 leading-relaxed">
          Edibility and toxicity information is educational only. Identification from a web page is never a
          substitute for an expert. Unverified species are marked
          <span class="text-lab-100">unknown — treat as inedible</span>, and deadly look-alikes are flagged in
          both directions. Never eat a wild fungus on the basis of this catalog alone.
        </p>
      </div>
    </div>

    <div class="border border-lab-800 p-8">
      <span class="label text-bio-500">// Open Source</span>
      <h2 class="text-2xl font-semibold text-lab-100 mt-2">Built in the open. Owned by no one.</h2>
      <p class="text-lab-400 mt-3 max-w-2xl leading-relaxed">
        The code, the dataset, and the teks are all open and CC-BY. Found an error, have a source, want to write
        a profile — the repository is yours to edit.
      </p>
      <div class="flex flex-wrap gap-3 mt-6">
        <a href="https://github.com/MycoSci" class="btn btn-primary">Contribute on GitHub</a>
        <a href="/api" class="btn btn-secondary">Use the API</a>
      </div>
    </div>
  </div>
</BaseLayout>
