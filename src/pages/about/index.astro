---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="About | MycoSci">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="label text-bio-500">ABOUT US</span>
      <h1 class="text-3xl sm:text-4xl font-bold text-lab-100 mt-2">MycoSci Research Lab</h1>
      <p class="text-lab-400 mt-4 max-w-2xl mx-auto">
        Open source mycology research infrastructure for the community.
      </p>
    </div>

    <!-- Mission -->
    <div class="card p-8 mb-8">
      <h2 class="text-xl font-semibold text-lab-100 mb-4">Our Mission</h2>
      <p class="text-lab-400 leading-relaxed">
        MycoSci is building open, accessible tools for mycology research. We believe that understanding
        fungi—from their taxonomy and ecology to their cultivation and applications—should be available
        to everyone. Our platform combines AI-powered identification, comprehensive species documentation,
        and professional-grade genetic preservation services.
      </p>
    </div>

    <!-- What we do -->
    <div class="grid md:grid-cols-2 gap-6 mb-12">
      <div class="card p-6">
        <span class="text-3xl block mb-4">🧬</span>
        <h3 class="font-semibold text-lab-100 mb-2">Gene Banking</h3>
        <p class="text-sm text-lab-500">
          Long-term cryo storage in partnership with university research labs.
          Preserve your genetics for years of consistent cultivation.
        </p>
      </div>
      <div class="card p-6">
        <span class="text-3xl block mb-4">🔬</span>
        <h3 class="font-semibold text-lab-100 mb-2">AI Detection</h3>
        <p class="text-sm text-lab-500">
          Offline-capable mushroom identification trained on research-grade observations.
          Runs entirely on your device—no data leaves your phone.
        </p>
      </div>
      <div class="card p-6">
        <span class="text-3xl block mb-4">📊</span>
        <h3 class="font-semibold text-lab-100 mb-2">Species Database</h3>
        <p class="text-sm text-lab-500">
          Comprehensive documentation of 900+ species with morphology, ecology,
          and genetic data. Open and freely accessible.
        </p>
      </div>
      <div class="card p-6">
        <span class="text-3xl block mb-4">🧪</span>
        <h3 class="font-semibold text-lab-100 mb-2">Lab Supplies</h3>
        <p class="text-sm text-lab-500">
          Quality agar, liquid culture, and equipment for serious cultivation work.
          Everything you need for clean technique.
        </p>
      </div>
    </div>

    <!-- Open Source -->
    <div class="card p-8 border-bio-600/30 bg-bio-950/20 text-center">
      <span class="text-4xl block mb-4">💻</span>
      <h2 class="text-xl font-semibold text-lab-100 mb-3">Open Source</h2>
      <p class="text-lab-400 mb-6 max-w-lg mx-auto">
        Our codebase, species database, and AI models are open source.
        Contribute, fork, or use them for your own research.
      </p>
      <a href="https://github.com/MycoSci" class="btn btn-primary">
        <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        View on GitHub
      </a>
    </div>
  </div>
</BaseLayout>
