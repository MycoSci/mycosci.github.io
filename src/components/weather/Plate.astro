---
/**
 * One map, with what is and is not known about how well it ranks.
 *
 * WHAT THIS FIGURE LEADS WITH (changed 2026-10-17, at the owner's direction)
 *
 * The zoomable data map leads. The rendered PNG — which was the headline from
 * the day this page existed — is now the fallback: present in the document,
 * hidden the instant scripting is confirmed, and brought back by MapExplore
 * whenever the data map cannot draw. The instruction was "instead of the png
 * and exploratory maps just show the data map", and the reasoning behind
 * obeying it is that a map hidden behind a button is a map most readers never
 * see, while a picture of a map cannot be zoomed, panned or switched.
 *
 * HOW THE FALLBACK IS KEPT HONEST, which is the whole difficulty here
 *
 * Hiding the picture is done by a tiny inline script sitting immediately after
 * it, NOT by a CSS class and not by a `<noscript>` block. The reason is that
 * only one condition justifies hiding it — "scripting is running, so
 * MapExplore will get a chance to draw" — and an inline script is the only
 * thing that can state exactly that condition, before first paint, with no
 * flash of a picture that then vanishes. A reader with scripting off never
 * runs it and keeps the picture. A reader whose map then fails gets the
 * picture back, plus the reason, via `fallBack()` in MapExplore.astro.
 *
 * `[data-plate]` on the figure is the handle MapExplore reaches through to do
 * that, so the two attribute names are a contract between these two files.
 *
 * Two older failure modes are still handled explicitly rather than left to
 * chance, and neither was weakened by the reordering:
 *
 *   1. A species whose ranking has not been back-tested still gets its plate,
 *      and it is still a foraging map — that is what this section is. What it
 *      gets alongside is the state of the evidence, stated plainly rather than
 *      implied. Lobster's best real record ever sat on ground scoring 0.195,
 *      well under what today's lobster map paints, so a lobster plate with no
 *      note would let a reader take its brightest ground for a tested result.
 *      The statement rides with the picture: a note above it on a headline
 *      page, a badge in its caption everywhere. (Settled 2026-09-10, at the
 *      owner's direction; reworded 2026-09-10 after the first version spent
 *      the space disowning the map instead of describing it.)
 *   2. The image lives on a host we control rather than in the same commit
 *      as the page, so it can be absent. The URL is content-addressed by run
 *      date and digest, so a stale origin can only 404 — but a 404 must look
 *      like a 404, not like an empty map. A failed load replaces the picture
 *      with what is missing and the digest that would prove it. That path now
 *      matters more, not less: it is the fallback's own fallback.
 */
import MapExplore from './MapExplore.astro';
import {
  imageState,
  noteBody,
  notBackTested,
  overlayState,
  type ManifestSpecies,
  type RunRecord,
} from '../../lib/weather';

interface Props {
  species: ManifestSpecies;
  run: RunRecord;
  /** A headline page carries the evidence note above the plate; a page that
   *  already states it above (the species page) passes false. */
  headline?: boolean;
}
const { species, run, headline = true } = Astro.props;

const untested = notBackTested(species.id);
const img = imageState(run, species.id);

/**
 * Will MapExplore draw anything at all?
 *
 * Asked here, with the same function MapExplore uses, because the answer
 * decides whether the PNG is a fallback (hide it, scripting permitting) or the
 * only map this plate has (leave it alone, forever). Getting this wrong in the
 * "no overlay" direction would ship a plate with no map in it, which is the
 * one outcome neither file is allowed to produce.
 */
const hasDataMap = overlayState(run, species.id).url !== null && run.manifest?.extent !== undefined;

// The record's "highest score any real record ever sat on" is only worth
// saying when this run paints ground above it — that is the case where a
// reader could take an untested bright patch for a proven one. Where the
// ceiling sits above today's peak (morel: 0.812 against a 0.62 map) the same
// sentence is just noise, so it is not printed.
const recordCeiling =
  typeof untested?.max_observed_score === 'number' &&
  (species.max_score ?? 0) > untested.max_observed_score
    ? untested.max_observed_score
    : null;

const assessed = species.pixels_assessed || 1;
const painted = species.pixels_painted ?? 0;
const paintedPct = (100 * painted) / assessed;
const maxScore = species.max_score ?? 0;
const name = species.common_name ?? species.id;

const alt =
  `Map of Oregon showing predicted ${name} fruiting likelihood for ${run.target_date}. ` +
  `${paintedPct.toFixed(0)} percent of assessed ground is painted; the highest score anywhere ` +
  `is ${maxScore.toFixed(2)}.`;
---

<figure class="border border-lab-800 bg-lab-900" data-plate>
  {
    untested && headline && (
      <div class="border-b border-spore-600/40 bg-spore-600/5 px-5 py-4">
        <p class="font-mono text-2xs uppercase tracking-wider text-spore-400">
          Ranking not back-tested
        </p>
        <p class="text-sm text-lab-300 mt-2 leading-relaxed">
          This is the model's real output for {name}, scored the same way as every other map
          here. What has not happened is the check: nobody has measured yet how well these
          scores rank ground against real records. {noteBody(untested.note)}
        </p>
        {recordCeiling !== null && (
          <p class="text-sm text-lab-400 mt-2 leading-relaxed">
            Worth knowing while you read it: no real record of this species has ever sat on
            ground scoring above{' '}
            <span class="font-mono text-lab-200">{recordCeiling.toFixed(3)}</span>, and this map
            paints brighter than that. Treat its brightest ground as a lead, not a result.
          </p>
        )}
      </div>
    )
  }

  {/* THE MAP. Mounts itself when this plate is the visible one. */}
  <MapExplore species={species} run={run} />

  {/* --------------------------------------------------------------------
      The rendered picture, now the fallback.

      Shown by default so that a document with no scripting is a document
      with a map. The inline script below hides it, and MapExplore brings
      it back if it cannot draw. Nothing about the image itself changed —
      including its own 404 handling, which is the layer beneath this one.
  --------------------------------------------------------------------- */}
  <div class="border-t border-lab-800" data-plate-static>
    <p
      class="px-5 py-3 text-xs text-lab-500 leading-relaxed border-b border-lab-800"
      data-plate-static-reason
    >
      The rendered picture of this map — it carries place names and its own legend baked in.
    </p>

    <div class="relative bg-lab-950" data-plate-img>
      {img.url ? (
        <a href={img.url} class="block">
          <img
            src={img.url}
            alt={alt}
            width={1456}
            height={1092}
            loading="lazy"
            decoding="async"
            class="w-full h-auto block"
            onerror="this.closest('[data-plate-img]').setAttribute('data-plate-failed','');"
          />
        </a>
      ) : null}

      <div class="plate-fallback px-5 py-8 text-center" data-has-image={img.url ? '' : null}>
        <p class="font-mono text-2xs uppercase tracking-wider text-spore-400">
          Map image unavailable
        </p>
        <p class="text-sm text-lab-300 mt-3 max-w-xl mx-auto leading-relaxed">
          The run for <span class="font-mono text-lab-100">{run.as_of_date}</span> recorded a
          map for {name}, but it did not load from the map origin.
          {img.note}
        </p>
        {img.image?.published_sha256 && (
          <p class="font-mono text-2xs text-lab-500 mt-3 break-all">
            expected sha256 {img.image.published_sha256.slice(0, 24)}…
          </p>
        )}
        <p class="text-xs text-lab-500 mt-3">
          The numbers on this page come from the run record and are unaffected.
        </p>
      </div>
    </div>
  </div>

  {
    /* Hide the picture ONLY if scripting is live AND there is a data map for
       MapExplore to draw. `document.currentScript` is the element itself, so
       this needs no id and cannot address the wrong plate on a page holding
       seventeen of them. is:inline because it must run at parse time, in
       place — an Astro-processed module would be deferred and the picture
       would flash before vanishing. */
    hasDataMap && (
      <script
        is:inline
        set:html={
          "(function(){var s=document.currentScript,p=s&&s.previousElementSibling;" +
          "if(p&&p.hasAttribute('data-plate-static'))p.hidden=true;})();"
        }
      />
    )
  }

  <figcaption
    class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 px-5 py-3 border-t border-lab-800"
  >
    <span class="text-sm text-lab-100">
      <b>{name}</b>{' '}
      <i class="text-lab-400">{species.scientific_name}</i>
      {untested && <span class="badge badge-spore ml-2">not back-tested</span>}
    </span>
    <span class="font-mono text-2xs text-lab-500 tabular-nums whitespace-nowrap">
      {paintedPct.toFixed(1)}% of assessed ground painted · peak {maxScore.toFixed(2)}
    </span>
  </figcaption>

  {
    /* The full-size render stays one tap away whether or not its picture is on
       screen. It is the only thing here with place names printed into it, and
       it is the thing a reader saves to a phone before losing signal — so the
       link lives in the figure's furniture rather than inside the block that
       gets hidden. */
    img.url && (
      <p class="px-5 pb-4 text-xs text-lab-500">
        <a href={img.url} class="text-bio-400 hover:text-bio-300">
          Open the full-size rendered image
        </a>{' '}
        — 1456 pixels across, with place names and its own legend.
        {img.state === 'unverified' && (
          <span class="text-spore-400"> Its arrival on the map origin was never confirmed.</span>
        )}
      </p>
    )
  }
</figure>

<style>
  /* The fallback is inert while an image is expected, and takes over the frame
     the moment that image fails to load. A missing map must look missing. */
  .plate-fallback[data-has-image] {
    display: none;
  }
  [data-plate-failed] img {
    display: none;
  }
  [data-plate-failed] .plate-fallback[data-has-image] {
    display: block;
  }

  /* `hidden` on the static block has to beat nothing in particular today, but
     it sits next to utility classes that set `display`, and that is exactly
     the collision that left a loading scrim permanently on screen in
     MapExplore. Stated explicitly so the next person to add a class here
     cannot reintroduce it. */
  [data-plate-static][hidden] {
    display: none;
  }
</style>
