---
interface Props {
  type?: 'note' | 'tip' | 'caution' | 'danger';
  title?: string;
}
const { type = 'note', title } = Astro.props;

// Instrument-grade callouts — colored hairline + mono label, no emoji.
const typeConfig = {
  note:    { border: 'border-lab-600',   bg: 'bg-lab-900',      text: 'text-lab-400' },
  tip:     { border: 'border-bio-500',   bg: 'bg-bio-950/40',   text: 'text-bio-400' },
  caution: { border: 'border-spore-500', bg: 'bg-spore-600/10', text: 'text-spore-400' },
  danger:  { border: 'border-red-500',   bg: 'bg-red-500/10',   text: 'text-red-400' },
};
const config = typeConfig[type];
---

<aside class={`border-l-2 ${config.border} ${config.bg} px-4 py-3 mb-4`}>
  <div class={`text-2xs font-mono uppercase tracking-[0.2em] mb-1.5 ${config.text}`}>
    {title || type}
  </div>
  <div class="text-sm text-lab-300 leading-relaxed">
    <slot />
  </div>
</aside>
