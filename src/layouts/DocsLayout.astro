---
import type { DocsNavNode } from '../utils/getDocsNav';

interface Props {
  title?: string;
  description?: string;
  nav: DocsNavNode[];
}

const { title, description, nav }: Props = Astro.props;

const normalize = (value?: string | null) => {
  if (!value) return undefined;
  return value.endsWith('/') ? value : `${value}/`;
};

interface NavNodeState extends DocsNavNode {
  normalizedUrl?: string;
  active: boolean;
  expanded: boolean;
  children: NavNodeState[];
}

const currentPath = normalize(Astro.url.pathname);

const annotate = (node: DocsNavNode): NavNodeState => {
  const normalizedUrl = normalize(node.url);
  const children = node.children.map(annotate);
  const active = normalizedUrl ? currentPath === normalizedUrl : false;
  const descendantActive = children.some(child => child.active || child.expanded);
  const expanded = descendantActive || active;
  return {
    ...node,
    normalizedUrl,
    active,
    expanded,
    children,
  };
};

const annotatedNav = nav.map(annotate);

const escapeHtml = (value: string) =>
  value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');

const renderNavHtml = (items: NavNodeState[], level = 0): string =>
  items
    .map(item => {
      const levelClass = ` level-${level}`;
      if (item.children.length > 0) {
        const openAttr = item.expanded ? ' open' : '';
        const summary = `<summary>${escapeHtml(item.title)}</summary>`;
        const selfLink = item.url
          ? `<li class=\"docs-nav__leaf\"><a class=\"docs-nav__link${item.active ? ' is-current' : ''}\" href=\"${escapeHtml(item.url)}\">${escapeHtml(item.title)}</a></li>`
          : '';
        const childrenHtml = renderNavHtml(item.children, level + 1);
        const classes = `docs-nav__item docs-nav__item--group${levelClass}${item.expanded ? ' is-expanded' : ''}`;
        return `<li class=\"${classes}\"><details class=\"docs-nav__group\"${openAttr}>${summary}<ul role=\"list\">${selfLink}${childrenHtml}</ul></details></li>`;
      }
      const classes = `docs-nav__item docs-nav__item--leaf${levelClass}${item.active ? ' is-active' : ''}`;
      const content = item.url
        ? `<a class=\"docs-nav__link${item.active ? ' is-current' : ''}\" href=\"${escapeHtml(item.url)}\">${escapeHtml(item.title)}</a>`
        : `<span class=\"docs-nav__label\">${escapeHtml(item.title)}</span>`;
      return `<li class=\"${classes}\">${content}</li>`;
    })
    .join('');

const navHtml = renderNavHtml(annotatedNav);

const docsHome = import.meta.env.STARLIGHT_ENABLED ? '/docs/' : '/mycopedia/';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <title>{title ? `${title} | MycoSci` : 'MycoSci Docs'}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :global(body.docs-body) {
        margin: 0;
        background: var(--docs-bg);
        color: var(--docs-ink);
        font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
        line-height: 1.6;
        min-height: 100vh;
      }

      :global(body.docs-body *) {
        box-sizing: border-box;
      }

      :root {
        color-scheme: light;
        --docs-bg: #f8fafc;
        --docs-surface: #ffffff;
        --docs-panel: #eef2ff;
        --docs-border: #dbeafe;
        --docs-ink: #0f172a;
        --docs-muted: #475569;
        --docs-accent: #2563eb;
        --docs-accent-soft: rgba(37, 99, 235, 0.12);
      }

      .docs-shell {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      .docs-shell a {
        color: var(--docs-accent);
        text-decoration: none;
        transition: color 0.15s ease;
      }

      .docs-shell a:hover {
        text-decoration: underline;
      }

      .docs-header {
        background: linear-gradient(135deg, #0f172a, #1e293b);
        color: #f8fafc;
        position: sticky;
        top: 0;
        z-index: 30;
        border-bottom: 1px solid rgba(148, 163, 184, 0.25);
      }

      .docs-header__inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .docs-logo {
        font-size: 1.05rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #f8fafc;
      }

      .docs-logo:hover {
        color: #e0e7ff;
        text-decoration: none;
      }

      .docs-sidebar-toggle {
        display: none;
        align-items: center;
        gap: 0.45rem;
        padding: 0.45rem 0.85rem;
        border-radius: 0.75rem;
        border: 1px solid rgba(248, 250, 252, 0.45);
        background: rgba(148, 163, 184, 0.15);
        color: #f8fafc;
        font-weight: 500;
        cursor: pointer;
      }

      .docs-sidebar-toggle:focus-visible {
        outline: 2px solid #f8fafc;
        outline-offset: 3px;
      }

      .docs-sidebar-toggle svg {
        width: 1.1rem;
        height: 1.1rem;
      }

      .docs-main {
        flex: 1;
        display: grid;
        grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
        gap: 2.5rem;
        padding: 2.5rem 1.5rem 3rem;
        max-width: 1200px;
        margin: 0 auto;
        width: 100%;
      }

      .docs-sidebar {
        background: var(--docs-surface);
        border: 1px solid var(--docs-border);
        border-radius: 1rem;
        padding: 1.5rem;
        position: sticky;
        top: 6rem;
        max-height: calc(100vh - 7.5rem);
        overflow: auto;
        box-shadow: 0 18px 48px rgba(15, 23, 42, 0.08);
      }

      .docs-sidebar nav {
        display: block;
      }

      .docs-nav__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }

      .docs-nav__item {
        list-style: none;
      }

      .docs-nav__group {
        border-radius: 0.85rem;
        border: 1px solid transparent;
        background: transparent;
      }

      .docs-nav__group[open] {
        border-color: rgba(37, 99, 235, 0.22);
        background: rgba(37, 99, 235, 0.05);
      }

      .docs-nav__group summary {
        list-style: none;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.65rem 0.75rem;
        border-radius: 0.75rem;
        color: var(--docs-ink);
      }

      .docs-nav__group summary::-webkit-details-marker {
        display: none;
      }

      .docs-nav__group summary::after {
        content: '';
        width: 0.65rem;
        height: 0.65rem;
        border-right: 2px solid currentColor;
        border-bottom: 2px solid currentColor;
        transform: rotate(-45deg);
        margin-left: auto;
        transition: transform 0.2s ease;
        opacity: 0.65;
      }

      .docs-nav__group[open] summary::after {
        transform: rotate(45deg);
        opacity: 1;
      }

      .docs-nav__group summary:focus-visible {
        outline: 2px solid var(--docs-accent);
        outline-offset: 3px;
      }

      .docs-nav__group ul {
        list-style: none;
        margin: 0;
        padding: 0.45rem 0 0.6rem 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .docs-nav__link {
        display: block;
        padding: 0.45rem 0.75rem;
        border-radius: 0.65rem;
        color: var(--docs-muted);
        font-size: 0.92rem;
        font-weight: 500;
      }

      .docs-nav__link:hover {
        background: rgba(37, 99, 235, 0.08);
        color: var(--docs-ink);
        text-decoration: none;
      }

      .docs-nav__link.is-current {
        background: rgba(37, 99, 235, 0.12);
        color: var(--docs-accent);
        box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.35);
      }

      .docs-nav__label {
        display: block;
        padding: 0.45rem 0.75rem;
        color: var(--docs-muted);
        font-size: 0.92rem;
      }

      .docs-content {
        background: var(--docs-surface);
        border-radius: 1rem;
        padding: 2.5rem;
        box-shadow: 0 18px 52px rgba(15, 23, 42, 0.1);
        border: 1px solid rgba(148, 163, 184, 0.18);
        min-width: 0;
      }

      .docs-content__header {
        margin-bottom: 2rem;
        border-bottom: 1px solid var(--docs-border);
        padding-bottom: 1.5rem;
      }

      .docs-content__header h1 {
        margin: 0 0 0.6rem;
        font-size: clamp(2.2rem, 4vw, 2.75rem);
        letter-spacing: -0.01em;
      }

      .docs-content__header p {
        margin: 0;
        color: var(--docs-muted);
        font-size: 1rem;
      }

      .docs-content :global(h2) {
        font-size: clamp(1.7rem, 3.1vw, 2rem);
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        color: var(--docs-ink);
      }

      .docs-content :global(h3) {
        font-size: clamp(1.35rem, 2.4vw, 1.55rem);
        margin-top: 1.8rem;
        margin-bottom: 0.75rem;
        color: var(--docs-ink);
      }

      .docs-content :global(p) {
        margin: 0 0 1rem;
        color: var(--docs-muted);
      }

      .docs-content :global(ul),
      .docs-content :global(ol) {
        padding-left: 1.5rem;
        margin: 0 0 1.25rem;
      }

      .docs-content :global(blockquote) {
        border-left: 3px solid var(--docs-accent);
        padding-left: 1rem;
        margin: 1.5rem 0;
        color: var(--docs-muted);
        background: rgba(37, 99, 235, 0.06);
        border-radius: 0 0.75rem 0.75rem 0;
      }

      .docs-content :global(code) {
        font-family: 'IBM Plex Mono', 'SFMono-Regular', ui-monospace, monospace;
        font-size: 0.9rem;
        background: rgba(15, 23, 42, 0.06);
        padding: 0.15rem 0.35rem;
        border-radius: 0.35rem;
      }

      .docs-content :global(pre) {
        background: #0f172a;
        color: #f8fafc;
        padding: 1rem 1.25rem;
        border-radius: 0.9rem;
        overflow: auto;
        margin: 1.75rem 0;
      }

      .docs-content :global(pre code) {
        background: transparent;
        color: inherit;
        padding: 0;
      }

      .docs-footer {
        max-width: 1200px;
        margin: 0 auto;
        width: 100%;
        padding: 2rem 1.5rem 3rem;
        color: var(--docs-muted);
        font-size: 0.9rem;
      }

      .docs-footer__inner {
        border-top: 1px solid var(--docs-border);
        padding-top: 1.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: space-between;
      }

      .docs-sidebar-scrim {
        display: none;
      }

      @media (max-width: 960px) {
        .docs-sidebar-toggle {
          display: inline-flex;
        }

        .docs-main {
          display: block;
          padding: 2rem 1.25rem 3rem;
        }

        .docs-sidebar {
          position: fixed;
          top: 4.75rem;
          left: 0;
          bottom: 0;
          width: min(22rem, 85vw);
          border-radius: 0 1rem 1rem 0;
          transform: translateX(-110%);
          transition: transform 0.25s ease;
          max-height: none;
          box-shadow: 0 1.5rem 3.5rem rgba(15, 23, 42, 0.25);
          border: 0;
          z-index: 40;
        }

        .docs-shell.sidebar-open .docs-sidebar {
          transform: translateX(0);
        }

        .docs-sidebar-scrim {
          display: none;
        }

        .docs-shell.sidebar-open .docs-sidebar-scrim {
          display: block;
          position: fixed;
          inset: 0;
          background: rgba(15, 23, 42, 0.35);
          backdrop-filter: blur(2px);
          z-index: 25;
        }

        .docs-content {
          padding: 1.75rem;
          margin-top: 1.5rem;
        }
      }

      @media (max-width: 640px) {
        .docs-content {
          padding: 1.5rem;
        }

        .docs-content__header h1 {
          font-size: clamp(2rem, 8vw, 2.35rem);
        }
      }
    </style>
  </head>
  <body class="docs-body">
    <div class="docs-shell" data-docs-shell>
      <header class="docs-header">
        <div class="docs-header__inner">
          <a class="docs-logo" href="/">MycoSci</a>
          <button
            class="docs-sidebar-toggle"
            type="button"
            data-sidebar-toggle
            aria-controls="docs-sidebar"
            aria-expanded="false"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
              <path
                fill="currentColor"
                d="M4 6.75C4 6.34 4.34 6 4.75 6h14.5c.41 0 .75.34.75.75s-.34.75-.75.75H4.75A.75.75 0 0 1 4 6.75Zm0 5.25c0-.41.34-.75.75-.75h14.5c.41 0 .75.34.75.75s-.34.75-.75.75H4.75A.75.75 0 0 1 4 12Zm.75 4.5a.75.75 0 0 0 0 1.5h14.5a.75.75 0 0 0 0-1.5H4.75Z"
              ></path>
            </svg>
            Menu
          </button>
        </div>
      </header>
      <main class="docs-main">
        <aside
          class="docs-sidebar"
          id="docs-sidebar"
          data-docs-sidebar
          aria-label="Documentation navigation"
          aria-hidden="true"
        >
          <nav class="docs-nav">
            <ul class="docs-nav__list" role="list" set:html={navHtml}></ul>
          </nav>
        </aside>
        <div class="docs-sidebar-scrim" data-sidebar-scrim></div>
        <article class="docs-content">
          {(title || description) && (
            <header class="docs-content__header">
              {title && <h1>{title}</h1>}
              {description && <p>{description}</p>}
            </header>
          )}
          <slot />
        </article>
      </main>
      <footer class="docs-footer">
        <div class="docs-footer__inner">
          <span>© {new Date().getFullYear()} MycoSci.</span>
          <a href={docsHome}>Back to documentation overview</a>
        </div>
      </footer>
    </div>
    <script>
      const shell = document.querySelector('[data-docs-shell]');
      const toggle = document.querySelector('[data-sidebar-toggle]');
      const sidebar = document.querySelector('[data-docs-sidebar]');
      const scrim = document.querySelector('[data-sidebar-scrim]');

      if (shell && toggle && sidebar && scrim) {
        const closeSidebar = () => {
          shell.classList.remove('sidebar-open');
          toggle.setAttribute('aria-expanded', 'false');
          sidebar.setAttribute('aria-hidden', 'true');
        };

        toggle.addEventListener('click', () => {
          const isOpen = shell.classList.toggle('sidebar-open');
          toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          sidebar.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
        });

        scrim.addEventListener('click', closeSidebar);

        sidebar.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            if (window.matchMedia('(max-width: 960px)').matches) {
              closeSidebar();
            }
          });
        });

        const media = window.matchMedia('(max-width: 960px)');
        const syncSidebarState = () => {
          if (media.matches) {
            sidebar.setAttribute('aria-hidden', shell.classList.contains('sidebar-open') ? 'false' : 'true');
          } else {
            sidebar.removeAttribute('aria-hidden');
            shell.classList.remove('sidebar-open');
            toggle.setAttribute('aria-expanded', 'false');
          }
        };

        media.addEventListener('change', syncSidebarState);
        syncSidebarState();
      }
    </script>
  </body>
</html>
