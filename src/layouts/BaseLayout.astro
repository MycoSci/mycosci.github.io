---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'MycoSci',
  description = 'An open, free catalog of the fungal kingdom — every species, every tek, machine-readable.'
} = Astro.props;

const navItems = [
  { href: '/database', label: 'Catalog' },
  { href: '/docs', label: 'Teks' },
  { href: '/api', label: 'API' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="flex flex-col min-h-screen bg-lab-950">
    <!-- Header -->
    <header class="sticky top-0 z-40 border-b border-lab-800 bg-lab-950/90 backdrop-blur-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between h-14">
          <!-- Wordmark -->
          <a href="/" class="flex items-center gap-3 group">
            <div class="w-7 h-7 border border-lab-600 flex items-center justify-center group-hover:border-bio-400 transition-colors">
              <span class="text-lab-100 font-mono font-semibold text-xs group-hover:text-bio-400 transition-colors">M</span>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="font-mono font-semibold text-lab-100 text-sm tracking-[0.15em]">MYCOSCI</span>
              <span class="hidden sm:inline text-2xs font-mono text-lab-500 tracking-[0.2em]">FUNGAL CATALOG</span>
            </div>
          </a>

          <!-- Navigation -->
          <nav class="hidden md:flex items-center gap-6">
            {navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'text-xs font-mono uppercase tracking-wider transition-colors duration-150 pb-0.5 border-b',
                  isActive(item.href)
                    ? 'text-bio-400 border-bio-400'
                    : 'text-lab-400 border-transparent hover:text-lab-100'
                ]}
              >
                {item.label}
              </a>
            ))}
          </nav>

          <!-- Right side -->
          <div class="flex items-center gap-4">
            <a href="/database" aria-label="Search" class="text-lab-400 hover:text-lab-100 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-5.2-5.2M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
              </svg>
            </a>
            <a href="https://github.com/MycoSci" class="hidden sm:inline text-xs font-mono uppercase tracking-wider text-lab-400 hover:text-lab-100 transition-colors">
              GitHub
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Main content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-lab-800 bg-lab-950">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-10">
          <div>
            <h4 class="label mb-4">Catalog</h4>
            <ul class="space-y-2.5">
              <li><a href="/database" class="text-sm text-lab-400 hover:text-bio-400 transition-colors">Species Catalog</a></li>
              <li><a href="/database" class="text-sm text-lab-400 hover:text-bio-400 transition-colors">Browse by Phylum</a></li>
              <li><a href="/api" class="text-sm text-lab-400 hover:text-bio-400 transition-colors">JSON API</a></li>
            </ul>
          </div>
          <div>
            <h4 class="label mb-4">Knowledge</h4>
            <ul class="space-y-2.5">
              <li><a href="/docs" class="text-sm text-lab-400 hover:text-bio-400 transition-colors">Cultivation Teks</a></li>
              <li><a href="/docs" class="text-sm text-lab-400 hover:text-bio-400 transition-colors">Lab Methods</a></li>
              <li><a href="/blog" class="text-sm text-lab-400 hover:text-bio-400 transition-colors">Field Notes</a></li>
            </ul>
          </div>
          <div>
            <h4 class="label mb-4">Project</h4>
            <ul class="space-y-2.5">
              <li><a href="/about" class="text-sm text-lab-400 hover:text-bio-400 transition-colors">About</a></li>
              <li><a href="https://github.com/MycoSci" class="text-sm text-lab-400 hover:text-bio-400 transition-colors">Source Code</a></li>
              <li><a href="https://github.com/MycoSci" class="text-sm text-lab-400 hover:text-bio-400 transition-colors">Contribute</a></li>
            </ul>
          </div>
          <div>
            <h4 class="label mb-4">Notice</h4>
            <p class="text-xs text-lab-500 leading-relaxed">
              Edibility and toxicity data is informational only. Never consume a wild fungus
              on the basis of this catalog alone.
            </p>
          </div>
        </div>

        <div class="divider mb-6"></div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-2xs font-mono text-lab-500 uppercase tracking-wider">
          <span>© 2026 MycoSci · Open Source · CC-BY</span>
          <div class="flex items-center gap-4">
            <span>Build 0.1.0</span>
            <span class="text-lab-700">/</span>
            <span class="flex items-center gap-2">
              <span class="status-dot status-active"></span>
              Static · GitHub Pages
            </span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
