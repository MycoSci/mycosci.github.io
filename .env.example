# Where the MycoMap fruiting-map images are served from.
# One value, in one place: the site (src/lib/weather.ts) and the publish script
# (scripts/publish-weather.mjs) both read it, so they cannot drift.
#
# The origin is cdn.opsblu.com — shared across projects, permanently — so this
# MUST keep the /mycomap/ project prefix. The run record stores paths relative
# to this base (<as_of>/<sha12>-<name>.png); drop the prefix and MycoMap's dated
# directories land at the origin root and claim a namespace other projects want.
#
# Production: https://cdn.opsblu.com/mycomap/maps
# Local dev:  /maps, after `npm run weather:local` copies the staged renders
#             into public/maps/.
# CI:         the GitHub Actions repository variable MAPS_BASE_URL.
PUBLIC_MAPS_BASE_URL=https://cdn.opsblu.com/mycomap/maps

# rsync destination for `npm run weather -- --upload`. Must be the filesystem
# path behind PUBLIC_MAPS_BASE_URL on the origin host. The upload is gated by
# sandbox/mycomap/scripts/cdn-publish.sh --guard, which enforces retention, a
# per-project byte cap and a global free-space floor — this target is MISTY's
# production root filesystem.
MYCOMAP_MAPS_RSYNC_DEST=
