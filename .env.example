# Where the MycoMap fruiting-map images are served from.
# One value, in one place: the site (src/lib/weather.ts) and the publish script
# (scripts/publish-weather.mjs) both read it, so they cannot drift.
#
# Production: the origin we run behind Caddy, e.g. https://maps.mycosci.com
# Local dev:  /maps, after `npm run weather:local` copies the staged renders
#             into public/maps/.
PUBLIC_MAPS_BASE_URL=https://maps.mycosci.com

# rsync destination for `npm run weather -- --upload`, e.g.
# MYCOMAP_MAPS_RSYNC_DEST=josh@192.168.1.200:/srv/mycomap-maps
MYCOMAP_MAPS_RSYNC_DEST=
