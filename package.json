{
  "name": "mycosci",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "data": "node scripts/build-data.mjs && node scripts/build-api.mjs",
    "weather": "node scripts/publish-weather.mjs",
    "weather:local": "mkdir -p public/maps && cp -R .weather-out/. public/maps/ && echo \"staged .weather-out -> public/maps (set PUBLIC_MAPS_BASE_URL=/maps for local dev)\"",
    "prebuild": "npm run data",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.5",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/tailwind": "^6.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^5.6.1",
    "sharp": "^0.32.5",
    "tailwindcss": "^3.4.0"
  }
}
